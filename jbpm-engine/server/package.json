{
  "name": "@fabrixly/jbpm-engine-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BPM engine backend: Express API + token execution engine + stores",
  "main": "dist/index.js",
  "scripts": {
    "build:sidecar": "mkdir -p ../java-runtime/out && javac -d ../java-runtime/out $(find ../java-runtime/src -name '*.java')",
    "predev": "npm run build:sidecar",
    "pretest": "npm run build:sidecar",
    "prebuild": "npm run build:sidecar",
    "prestart": "npm run build:sidecar",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:pg": "node --import tsx --test test/pg/*.test.ts",
    "docker:up": "docker-compose -f ../docker-compose.yml up -d",
    "docker:down": "docker-compose -f ../docker-compose.yml down"
  },
  "dependencies": {
    "@fabrixly/bpmn-sdk": "file:../../bpmn-sdk",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
