{
  "kind": "drl",
  "model": {
    "package": "com.acme.rules",
    "imports": ["com.acme.model.Claim"],
    "globals": ["java.util.List approved"],
    "functions": [
      { "name": "calcFee", "returnType": "double", "params": [{ "type": "double", "name": "amount" }], "body": "return amount * 0.1;" }
    ],
    "declares": [
      { "name": "Escalation", "fields": [{ "name": "claim", "type": "Claim" }] }
    ],
    "queries": [
      { "name": "openClaims", "when": [{ "fact": "Claim", "bind": "$c", "constraints": [{ "field": "status", "op": "==", "value": "OPEN" }] }] }
    ],
    "rules": [
      {
        "name": "High value claim",
        "attrs": { "ruleflowGroup": "classify", "salience": 10 },
        "when": [
          { "fact": "Claim", "bind": "$c", "constraints": [{ "field": "amount", "op": ">", "value": 100000 }] }
        ],
        "then": [
          { "modify": "$c", "set": { "status": "HIGH" } }
        ]
      }
    ]
  }
}
