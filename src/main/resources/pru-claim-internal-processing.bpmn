        <bpmn2:extensionElements>
          <drools:onEntry-script scriptFormat="http://www.java.com/java">
            <drools:script>// Extract failed REST node parameters
org.kie.api.runtime.process.WorkItem failedWorkItem = (org.kie.api.runtime.process.WorkItem) kcontext.getNodeInstance().getVariable("WorkItem");
if (failedWorkItem != null) {
    String url = (String) failedWorkItem.getParameter("Url");
    String payload = (String) failedWorkItem.getParameter("ContentData");
    String ctx = "{\"url\":\"" + url + "\", \"payload\":" + payload + "}";
    kcontext.setVariable("resPayload", ctx);
} else {
    kcontext.setVariable("resPayload", "{\"url\":\"/api/v1/unknown\", \"payload\":{}}");
}</drools:script>
          </drools:onEntry-script>
