<?xml version='1.0' encoding='UTF-8'?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/bpmn20" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_proc1_def" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <!-- Item Definitions for Process Variables -->
  <bpmn2:itemDefinition id="_caseIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_policyNumberItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_claimTypeItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_applicablePoliciesItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_policyDataItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_extractedDataItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_uploadedDocumentsItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_bankAccountDetailsItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_flagSuicideItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_flagContestableItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_flagForeignDeathItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_flagAIDSItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_dateOfDeathItem" structureRef="java.util.Date"/>
  <bpmn2:itemDefinition id="_eligibilityResultItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_validationPassedItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_validationErrorsItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_allDocsVerifiedItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_missingDocsItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_reclassificationTypeItem" structureRef="java.lang.String"/>
  <bpmn2:itemDefinition id="_bankValidationResultItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_mrxCheckResultItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_allFlagsAndFundsItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_taxCheckResultItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_taxExceptionsItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_interestMethodConfirmedItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_examinerDecisionItem" structureRef="java.lang.String"/>
  <bpmn2:itemDefinition id="_benefitCalculationItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_adjustedBenefitCalculationItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_beneficiarySplitItem" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="_withholdingResultItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_payoutAmountItem" structureRef="java.lang.Double"/>
  <bpmn2:itemDefinition id="_pasLockStatusItem" structureRef="java.lang.String"/>
  <bpmn2:itemDefinition id="_knectTransactionIdItem" structureRef="java.lang.String"/>
  <bpmn2:itemDefinition id="_finalPaymentInstructionsItem" structureRef="java.lang.Object"/>
  <bpmn2:itemDefinition id="_reqPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_resPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_baseUrlItem" structureRef="String"/>
  <bpmn2:error id="REST_API_FAILURE" errorCode="REST_API_FAILURE"/>
  <!-- The main Process Definition -->
  <bpmn2:process id="prudential-claims-submission.pru-claim-internal-processing" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-claim-internal-processing" isExecutable="true" processType="Public">
    <!-- Properties / Variables -->
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:property id="policyNumber" itemSubjectRef="_policyNumberItem" name="policyNumber"/>
    <bpmn2:property id="claimType" itemSubjectRef="_claimTypeItem" name="claimType"/>
    <bpmn2:property id="applicablePolicies" itemSubjectRef="_applicablePoliciesItem" name="applicablePolicies"/>
    <bpmn2:property id="policyData" itemSubjectRef="_policyDataItem" name="policyData"/>
    <bpmn2:property id="extractedData" itemSubjectRef="_extractedDataItem" name="extractedData"/>
    <bpmn2:property id="uploadedDocuments" itemSubjectRef="_uploadedDocumentsItem" name="uploadedDocuments"/>
    <bpmn2:property id="bankAccountDetails" itemSubjectRef="_bankAccountDetailsItem" name="bankAccountDetails"/>
    <bpmn2:property id="flagSuicide" itemSubjectRef="_flagSuicideItem" name="flagSuicide"/>
    <bpmn2:property id="flagContestable" itemSubjectRef="_flagContestableItem" name="flagContestable"/>
    <bpmn2:property id="flagForeignDeath" itemSubjectRef="_flagForeignDeathItem" name="flagForeignDeath"/>
    <bpmn2:property id="flagAIDS" itemSubjectRef="_flagAIDSItem" name="flagAIDS"/>
    <bpmn2:property id="dateOfDeath" itemSubjectRef="_dateOfDeathItem" name="dateOfDeath"/>
    <bpmn2:property id="eligibilityResult" itemSubjectRef="_eligibilityResultItem" name="eligibilityResult"/>
    <bpmn2:property id="validationPassed" itemSubjectRef="_validationPassedItem" name="validationPassed"/>
    <bpmn2:property id="validationErrors" itemSubjectRef="_validationErrorsItem" name="validationErrors"/>
    <bpmn2:property id="allDocsVerified" itemSubjectRef="_allDocsVerifiedItem" name="allDocsVerified"/>
    <bpmn2:property id="missingDocuments" itemSubjectRef="_missingDocsItem" name="missingDocuments"/>
    <bpmn2:property id="reclassificationType" itemSubjectRef="_reclassificationTypeItem" name="reclassificationType"/>
    <bpmn2:property id="bankValidationResult" itemSubjectRef="_bankValidationResultItem" name="bankValidationResult"/>
    <bpmn2:property id="mrxCheckResult" itemSubjectRef="_mrxCheckResultItem" name="mrxCheckResult"/>
    <bpmn2:property id="allFlagsAndFunds" itemSubjectRef="_allFlagsAndFundsItem" name="allFlagsAndFunds"/>
    <bpmn2:property id="taxCheckResult" itemSubjectRef="_taxCheckResultItem" name="taxCheckResult"/>
    <bpmn2:property id="taxExceptions" itemSubjectRef="_taxExceptionsItem" name="taxExceptions"/>
    <bpmn2:property id="interestMethodConfirmed" itemSubjectRef="_interestMethodConfirmedItem" name="interestMethodConfirmed"/>
    <bpmn2:property id="examinerDecision" itemSubjectRef="_examinerDecisionItem" name="examinerDecision"/>
    <bpmn2:property id="benefitCalculation" itemSubjectRef="_benefitCalculationItem" name="benefitCalculation"/>
    <bpmn2:property id="adjustedBenefitCalculation" itemSubjectRef="_adjustedBenefitCalculationItem" name="adjustedBenefitCalculation"/>
    <bpmn2:property id="beneficiarySplit" itemSubjectRef="_beneficiarySplitItem" name="beneficiarySplit"/>
    <bpmn2:property id="withholdingResult" itemSubjectRef="_withholdingResultItem" name="withholdingResult"/>
    <bpmn2:property id="payoutAmount" itemSubjectRef="_payoutAmountItem" name="payoutAmount"/>
    <bpmn2:property id="pasLockStatus" itemSubjectRef="_pasLockStatusItem" name="pasLockStatus"/>
    <bpmn2:property id="knectTransactionId" itemSubjectRef="_knectTransactionIdItem" name="knectTransactionId"/>
    <bpmn2:property id="finalPaymentInstructions" itemSubjectRef="_finalPaymentInstructionsItem" name="finalPaymentInstructions"/>
    <bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <!-- Workflow Nodes -->
    <bpmn2:startEvent id="_P1_START" name="Start">
      <bpmn2:outgoing>_F_BOOTSTRAP</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="_F_BOOTSTRAP" sourceRef="_P1_START" targetRef="_P1_BOOTSTRAP"/>
    <!-- Node 0: Initialize Environment -->
    <bpmn2:scriptTask id="_P1_BOOTSTRAP" name="Script_Bootstrap" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_F_BOOTSTRAP</bpmn2:incoming>
      <bpmn2:outgoing>_P1_F1</bpmn2:outgoing>
      <bpmn2:script>String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try {
        url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL");
    } catch (Exception e) {}
}
if (url == null || url.isEmpty()) {
    url = "http://localhost:3000";
}
kcontext.setVariable("baseUrl", url);
System.out.println("Process Industrialized: Initialized Base URL to " + url);</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="_P1_F1" sourceRef="_P1_BOOTSTRAP" targetRef="_P1_N1"/>
    <!-- Node 1: Validate Submitted Data -->
    <bpmn2:task id="_P1_N1" drools:taskName="Rest" name="N1: ValidateData">
      <bpmn2:ioSpecification id="_P1_N1_io">
        <bpmn2:dataInput id="_P1_N1_AcceptCharset" name="AcceptCharset" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_AcceptHeader" name="AcceptHeader" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_AuthType" name="AuthType" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_AuthUrl" name="AuthUrl" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_ConnectTimeout" name="ConnectTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_Content" name="Content" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_ContentData" name="ContentData" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_ContentType" name="ContentType" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_ContentTypeCharset" name="ContentTypeCharset" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_HandleResponseErrors" name="HandleResponseErrors" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_Headers" name="Headers" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_Method" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_Password" name="Password" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_ReadTimeout" name="ReadTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_ResultClass" name="ResultClass" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_Url" name="Url" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N1_Username" name="Username" structureRef="String"/>
        <bpmn2:dataOutput id="_P1_N1_Result" name="Result" structureRef="String"/>
        <bpmn2:inputSet id="_P1_N1_inputSet">
          <bpmn2:dataInputRefs>_P1_N1_AcceptCharset</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_AcceptHeader</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_AuthType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_AuthUrl</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_ConnectTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_Content</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_ContentData</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_ContentType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_ContentTypeCharset</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_HandleResponseErrors</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_Headers</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_Method</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_Password</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_ReadTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_ResultClass</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_Url</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N1_Username</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_P1_N1_outputSet">
          <bpmn2:dataOutputRefs>_P1_N1_Result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:incoming>_P1_F1</bpmn2:incoming>
      <bpmn2:outgoing>_P1_F2</bpmn2:outgoing>
      <bpmn2:dataInputAssociation id="_P1_N1_assoc_Url">
        <bpmn2:sourceRef>baseUrl</bpmn2:sourceRef>
        <bpmn2:transformation xsi_type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[baseUrl + "/api/v1/claims/validate-data"]]></bpmn2:transformation>
        <bpmn2:targetRef>_P1_N1_Url</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N1_assoc_Method">
        <bpmn2:assignment id="_P1_N1_assign_Method">
          <bpmn2:from xsi_type="bpmn2:tFormalExpression"><![CDATA[POST]]></bpmn2:from>
          <bpmn2:to>_P1_N1_Method</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P1_N1_Method</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N1_assoc_ContentType">
        <bpmn2:assignment id="_P1_N1_assign_ContentType">
          <bpmn2:from xsi_type="bpmn2:tFormalExpression"><![CDATA[application/json]]></bpmn2:from>
          <bpmn2:to>_P1_N1_ContentType</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P1_N1_ContentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N1_assoc_HandleResponseErrors">
        <bpmn2:assignment id="_P1_N1_assign_HandleResponseErrors">
          <bpmn2:from xsi_type="bpmn2:tFormalExpression"><![CDATA[true]]></bpmn2:from>
          <bpmn2:to>_P1_N1_HandleResponseErrors</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P1_N1_HandleResponseErrors</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N1_assoc_ContentData">
        <bpmn2:sourceRef>reqPayload</bpmn2:sourceRef>
        <bpmn2:targetRef>_P1_N1_ContentData</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_P1_N1_assoc_Result">
        <bpmn2:sourceRef>_P1_N1_Result</bpmn2:sourceRef>
        <bpmn2:targetRef>resPayload</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:extensionElements>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("policyFlags", root.get("policyFlags"));
        kcontext.setVariable("validationPassed", root.get("validationPassed").asBoolean());
    } catch(Exception e) {}
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="_P1_F2" sourceRef="_P1_N1" targetRef="_P1_XG1"/>
    <!-- Gateway: Validation Passed? -->
    <bpmn2:exclusiveGateway id="_P1_XG1" name="Validation Passed?" gatewayDirection="Diverging">
      <bpmn2:incoming>_P1_F2</bpmn2:incoming>
      <bpmn2:outgoing>_P1_F3_OK</bpmn2:outgoing>
      <bpmn2:outgoing>_P1_F3_FAIL</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_P1_F3_OK" name="Yes" sourceRef="_P1_XG1" targetRef="_P1_N4">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return validationPassed == true;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P1_F3_FAIL" name="No" sourceRef="_P1_XG1" targetRef="_P1_N3">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return validationPassed == false;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <!-- Node 3: Log Validation Error & Notify -->
    <bpmn2:task id="_P1_N3" drools:taskName="Rest" name="N3: LogError">
      <bpmn2:ioSpecification id="_P1_N3_io">
        <bpmn2:dataInput id="_P1_N3_AcceptCharset" name="AcceptCharset" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_AcceptHeader" name="AcceptHeader" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_AuthType" name="AuthType" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_AuthUrl" name="AuthUrl" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_ConnectTimeout" name="ConnectTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_Content" name="Content" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_ContentData" name="ContentData" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_ContentType" name="ContentType" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_ContentTypeCharset" name="ContentTypeCharset" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_HandleResponseErrors" name="HandleResponseErrors" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_Headers" name="Headers" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_Method" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_Password" name="Password" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_ReadTimeout" name="ReadTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_ResultClass" name="ResultClass" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_Url" name="Url" structureRef="String"/>
        <bpmn2:dataInput id="_P1_N3_Username" name="Username" structureRef="String"/>
        <bpmn2:dataOutput id="_P1_N3_Result" name="Result" structureRef="String"/>
        <bpmn2:inputSet id="_P1_N3_inputSet">
          <bpmn2:dataInputRefs>_P1_N3_AcceptCharset</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_AcceptHeader</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_AuthType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_AuthUrl</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_ConnectTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_Content</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_ContentData</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_ContentType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_ContentTypeCharset</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_HandleResponseErrors</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_Headers</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_Method</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_Password</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_ReadTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_ResultClass</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_Url</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P1_N3_Username</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_P1_N3_outputSet">
          <bpmn2:dataOutputRefs>_P1_N3_Result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:incoming>_P1_F3_FAIL</bpmn2:incoming>
      <bpmn2:outgoing>_P1_F3_FAIL_END</bpmn2:outgoing>
      <bpmn2:dataInputAssociation id="_P1_N3_assoc_Url">
        <bpmn2:sourceRef>baseUrl</bpmn2:sourceRef>
        <bpmn2:transformation xsi_type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[baseUrl + "/api/v1/audit/log-failure"]]></bpmn2:transformation>
        <bpmn2:targetRef>_P1_N3_Url</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N3_assoc_Method">
        <bpmn2:assignment id="_P1_N3_assign_Method">
          <bpmn2:from xsi_type="bpmn2:tFormalExpression"><![CDATA[POST]]></bpmn2:from>
          <bpmn2:to>_P1_N3_Method</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P1_N3_Method</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N3_assoc_ContentType">
        <bpmn2:assignment id="_P1_N3_assign_ContentType">
          <bpmn2:from xsi_type="bpmn2:tFormalExpression"><![CDATA[application/json]]></bpmn2:from>
          <bpmn2:to>_P1_N3_ContentType</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P1_N3_ContentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N3_assoc_HandleResponseErrors">
        <bpmn2:assignment id="_P1_N3_assign_HandleResponseErrors">
          <bpmn2:from xsi_type="bpmn2:tFormalExpression"><![CDATA[true]]></bpmn2:from>
          <bpmn2:to>_P1_N3_HandleResponseErrors</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P1_N3_HandleResponseErrors</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P1_N3_assoc_ContentData">
        <bpmn2:sourceRef>reqPayload</bpmn2:sourceRef>
