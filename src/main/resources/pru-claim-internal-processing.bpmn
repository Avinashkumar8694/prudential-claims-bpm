          <bpmn2:targetRef>_P1_ERR_CALL_failedContext</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
      </bpmn2:callActivity>
      <bpmn2:sequenceFlow id="_P1_ERR_F2" sourceRef="_P1_ERROR_CALL" targetRef="_P1_ERROR_END"/>
      <bpmn2:endEvent id="_P1_ERROR_END" name="End Error Catch">
        <bpmn2:incoming>_P1_ERR_F2</bpmn2:incoming>
