    <bpmn2:property id="urlGetClaimIds" itemSubjectRef="_urlGetClaimIdsItem" name="urlGetClaimIds"/>
    <bpmn2:property id="urlEvaluateClaim" itemSubjectRef="_urlEvaluateClaimItem" name="urlEvaluateClaim"/>
    <bpmn2:sequenceFlow id="_A_F1" sourceRef="_A_START" targetRef="_A_BOOT"/>
    <bpmn2:sequenceFlow id="_A_F2" sourceRef="_A_BOOT" targetRef="_A_GETIDS"/>
    <bpmn2:sequenceFlow id="_A_F3" sourceRef="_A_GETIDS" targetRef="_A_EVAL"/>
    <bpmn2:sequenceFlow id="_A_F4" sourceRef="_A_EVAL" targetRef="_A_END"/>
    <bpmn2:startEvent id="_A_START" name="Run Per Claim Evaluation">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Run Per Claim Evaluation]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_A_F1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:scriptTask id="_A_BOOT" name="Script_Bootstrap" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_Bootstrap]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_A_F1</bpmn2:incoming>
      <bpmn2:outgoing>_A_F2</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) { try { url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL"); } catch (Exception e) {} }
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);
kcontext.setVariable("urlGetClaimIds", url + "/claims/get-claim-ids");
kcontext.setVariable("urlEvaluateClaim", url + "/claims/evaluate-claim");
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", Integer.valueOf(3)); }
System.out.println("[BPM][BOOTSTRAP] process=pru-claim-run-evaluation | piid=" + kcontext.getProcessInstance().getId() + " | caseId=" + kcontext.getVariable("caseId") + " | baseUrl=" + url);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="_A_GETIDS" drools:independent="true" drools:waitForCompletion="true" name="Get Claim IDs" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Get Claim IDs]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:GetClaimIds] process=pru-claim-run-evaluation | cid=" + kcontext.getVariable("cid") + " | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  java.util.List ids = new java.util.ArrayList();
  if (root.has("claimIds") && root.get("claimIds").isArray()) { for (com.fasterxml.jackson.databind.JsonNode idn : root.get("claimIds")) { ids.add(idn.asText()); } }
  kcontext.setVariable("claimIds", ids);
  System.out.println("[BPM][EXIT:GetClaimIds] claimIds=" + ids);
} catch(Exception e) { System.out.println("[BPM][EXIT:GetClaimIds][ERROR] " + e.getMessage()); } }]]></drools:script></drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_A_F2</bpmn2:incoming>
      <bpmn2:outgoing>_A_F3</bpmn2:outgoing>
