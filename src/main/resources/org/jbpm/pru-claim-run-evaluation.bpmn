        </bpmn2:inputSet>
        <bpmn2:outputSet id="oset__A_GETIDS"><bpmn2:dataOutputRefs>_A_GETIDS_ResultOutputX</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_cd"><bpmn2:sourceRef>reqPayload</bpmn2:sourceRef><bpmn2:targetRef>_A_GETIDS_ContentDataInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_ct"><bpmn2:targetRef>_A_GETIDS_ContentTypeInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_ct"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_ctf"><![CDATA[application/json]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_ctt">_A_GETIDS_ContentTypeInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_he"><bpmn2:targetRef>_A_GETIDS_HandleResponseErrorsInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_he"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_hef"><![CDATA[true]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_het">_A_GETIDS_HandleResponseErrorsInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_m"><bpmn2:targetRef>_A_GETIDS_MethodInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_m"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_mf"><![CDATA[POST]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_mt">_A_GETIDS_MethodInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_u"><bpmn2:targetRef>_A_GETIDS_UrlInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_u"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_uf"><![CDATA[#{baseUrl}/claims/get-claim-ids]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_ut">_A_GETIDS_UrlInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="doa__A_GETIDS_r"><bpmn2:sourceRef>_A_GETIDS_ResultOutputX</bpmn2:sourceRef><bpmn2:targetRef>resPayload</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:callActivity>
