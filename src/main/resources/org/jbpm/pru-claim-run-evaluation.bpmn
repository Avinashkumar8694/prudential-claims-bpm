  <bpmn2:process id="prudential-claims-submission.pru-claim-run-evaluation" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-claim-run-evaluation" isExecutable="true" processType="Public">
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:property id="claimType" itemSubjectRef="_claimTypeItem" name="claimType"/>
    <bpmn2:property id="claimIds" itemSubjectRef="_claimIdsItem" name="claimIds"/>
    <bpmn2:property id="claimResults" itemSubjectRef="_claimResultsItem" name="claimResults"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
