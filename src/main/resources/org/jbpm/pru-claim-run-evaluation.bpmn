      <bpmn2:dataInputAssociation id="dia_A_claimId"><bpmn2:sourceRef>_A_claimId</bpmn2:sourceRef><bpmn2:targetRef>_A_MI_claimIdInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
