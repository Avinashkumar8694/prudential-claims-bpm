        <bpmn2:dataOutput id="_A_GETIDS_ResultOutputX" drools:dtype="" itemSubjectRef="___A_GETIDS_ResultOutputXItem" name="Result"/>
        <bpmn2:inputSet id="iset__A_GETIDS">
          <bpmn2:dataInputRefs>_A_GETIDS_ContentDataInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_A_GETIDS_ContentTypeInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_A_GETIDS_HandleResponseErrorsInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_A_GETIDS_MethodInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_A_GETIDS_UrlInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="oset__A_GETIDS"><bpmn2:dataOutputRefs>_A_GETIDS_ResultOutputX</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_cd"><bpmn2:sourceRef>reqPayload</bpmn2:sourceRef><bpmn2:targetRef>_A_GETIDS_ContentDataInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_ct"><bpmn2:targetRef>_A_GETIDS_ContentTypeInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_ct"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_ctf"><![CDATA[application/json]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_ctt">_A_GETIDS_ContentTypeInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_he"><bpmn2:targetRef>_A_GETIDS_HandleResponseErrorsInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_he"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_hef"><![CDATA[true]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_het">_A_GETIDS_HandleResponseErrorsInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_m"><bpmn2:targetRef>_A_GETIDS_MethodInputX</bpmn2:targetRef><bpmn2:assignment id="asg__A_GETIDS_m"><bpmn2:from xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_mf"><![CDATA[POST]]></bpmn2:from><bpmn2:to xsi:type="bpmn2:tFormalExpression" id="asg__A_GETIDS_mt">_A_GETIDS_MethodInputX</bpmn2:to></bpmn2:assignment></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="dia__A_GETIDS_u"><bpmn2:sourceRef>urlGetClaimIds</bpmn2:sourceRef><bpmn2:targetRef>_A_GETIDS_UrlInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="doa__A_GETIDS_r"><bpmn2:sourceRef>_A_GETIDS_ResultOutputX</bpmn2:sourceRef><bpmn2:targetRef>resPayload</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="_A_EVAL" drools:independent="true" drools:waitForCompletion="true" name="Evaluate Claim" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname"><drools:metaValue><![CDATA[Evaluate Claim]]></drools:metaValue></drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY:EvaluateClaim] process=pru-claim-run-evaluation | cid=" + kcontext.getVariable("cid") + " | caseId=" + kcontext.getVariable("caseId") + " | claimIds=" + kcontext.getVariable("claimIds"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("cid", kcontext.getVariable("cid"));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimType", kcontext.getVariable("claimType"));
json.putPOJO("claimIds", kcontext.getVariable("claimIds"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String r = (String) kcontext.getVariable("resPayload");
if (r != null && !r.isEmpty()) { try {
  com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(r);
  java.util.List results = new java.util.ArrayList();
  com.fasterxml.jackson.databind.JsonNode arr = root.has("claimResults") ? root.get("claimResults") : root;
  if (arr != null && arr.isArray()) { for (com.fasterxml.jackson.databind.JsonNode it : arr) { results.add(it); } }
  else if (arr != null && arr.isObject()) { results.add(arr); }
  kcontext.setVariable("claimResults", results);
  System.out.println("[BPM][EXIT:EvaluateClaim] claimResults count=" + results.size());
} catch(Exception e) { System.out.println("[BPM][EXIT:EvaluateClaim][ERROR] " + e.getMessage()); } }]]></drools:script></drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_A_F3</bpmn2:incoming>
      <bpmn2:outgoing>_A_F4</bpmn2:outgoing>
