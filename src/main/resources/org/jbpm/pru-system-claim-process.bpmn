<bpmn2:callActivity id="_SC_REQ_EMAIL" drools:independent="true" drools:waitForCompletion="true" name="Send Requirement eMail to Claimant" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Send Requirement eMail to Claimant]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-system-claim-process | piid="+kcontext.getProcessInstance().getId()+" | node=Send Requirement eMail to Claimant");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Send Requirement eMail to Claimant "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_fpend</bpmn2:incoming><bpmn2:outgoing>_f11</bpmn2:outgoing><bpmn2:ioSpecification id="_id406"><bpmn2:dataInput id="_SC_REQ_EMAIL_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_SC_REQ_EMAIL_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_SC_REQ_EMAIL_AuthTypeInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_SC_REQ_EMAIL_AuthUrlInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_SC_REQ_EMAIL_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_SC_REQ_EMAIL_ContentDataInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_SC_REQ_EMAIL_ContentTypeInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_SC_REQ_EMAIL_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_SC_REQ_EMAIL_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_SC_REQ_EMAIL_HeadersInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_SC_REQ_EMAIL_MethodInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_SC_REQ_EMAIL_PasswordInputX" drools:dtype="" itemSubjectRef="___SC_REQ_EMAIL_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_SC_REQ_EMAIL_ReadTimeoutInputX" drools:dtype="" i