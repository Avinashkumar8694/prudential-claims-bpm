<bpmn2:signal id="_sig_StartSystemClaim" name="StartSystemClaim"/><bpmn2:signal id="_sig_PaymentProcess" name="PaymentProcess"/><bpmn2:signal id="_sig_ClaimExaminer" name="ClaimExaminer"/>
  <bpmn2:process id="prudential-claims-submission.pru-system-claim-process" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-system-claim-process" isExecutable="true" processType="Public">
<bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
<bpmn2:property id="claimId" itemSubjectRef="_claimIdItem" name="claimId"/>
<bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
<bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
<bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
<bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
<bpmn2:property id="applicablePolicies" itemSubjectRef="_applicablePoliciesItem" name="applicablePolicies"/>
<bpmn2:property id="claimType" itemSubjectRef="_claimTypeItem" name="claimType"/>
<bpmn2:property id="anyContestable" itemSubjectRef="_anyContestableItem" name="anyContestable"/>
<bpmn2:property id="mrxDiscrepancyFlag" itemSubjectRef="_mrxDiscrepancyFlagItem" name="mrxDiscrepancyFlag"/>
<bpmn2:property id="caseStpEligible" itemSubjectRef="_caseStpEligibleItem" name="caseStpEligible"/>
<bpmn2:property id="outcome" itemSubjectRef="_outcomeItem" name="outcome"/>
<bpmn2:property id="currentPolicy" itemSubjectRef="_currentPolicyItem" name="currentPolicy"/>
<bpmn2:property id="claimResult" itemSubjectRef="_claimResultItem" name="claimResult"/>
<bpmn2:property id="claimResults" itemSubjectRef="_claimResultsItem" name="claimResults"/>
<bpmn2:sequenceFlow id="_f1" sourceRef="_START" targetRef="_BOOT"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f2" sourceRef="_BOOT" targetRef="_XG_TYPE"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fdeath" name="Death" sourceRef="_XG_TYPE" targetRef="_SC_PEND"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Death]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "DEATH".equals(claimType);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fnondeath" name="Non-Death" sourceRef="_XG_TYPE" targetRef="_MERGE"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Non-Death]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"DEATH".equals(claimType);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f3" sourceRef="_SC_PEND" targetRef="_SC_CONTEST"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f4" sourceRef="_SC_CONTEST" targetRef="_XG_CONTEST"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fcy" name="Contestable" sourceRef="_XG_CONTEST" targetRef="_SC_MRX_PULL"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Contestable]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return anyContestable != null && anyContestable;]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fcn" name="Not contestable" sourceRef="_XG_CONTEST" targetRef="_MERGE"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Not contestable]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return anyContestable == null || !anyContestable;]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f5" sourceRef="_SC_MRX_PULL" targetRef="_SC_MRX_CHECK"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f6" sourceRef="_SC_MRX_CHECK" targetRef="_MERGE"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f7" sourceRef="_MERGE" targetRef="_SC_PERCLAIM"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f8" sourceRef="_SC_PERCLAIM" targetRef="_SC_AGG"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f9" sourceRef="_SC_AGG" targetRef="_XG_OUT"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fstp" name="STP" sourceRef="_XG_OUT" targetRef="_SC_CALC"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[STP]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "STP".equals(outcome);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f10" sourceRef="_SC_CALC" targetRef="_END_PAY"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fpend" name="Pending Requirement" sourceRef="_XG_OUT" targetRef="_SC_REQ_EMAIL"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Pending Requirement]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "PENDING_REQ".equals(outcome);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f11" sourceRef="_SC_REQ_EMAIL" targetRef="_SC_STATUS_PEND"></bpmn2:sequenceFlow>
