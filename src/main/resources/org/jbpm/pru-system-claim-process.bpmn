<bpmn2:callActivity id="_SC_CONTEST" drools:independent="true" drools:waitForCompletion="true" name="Check contestability (ANY policy)" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Check contestability (ANY policy)]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-system-claim-process | piid="+kcontext.getProcessInstance().getId()+" | node=Check contestability (ANY policy)");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
    kcontext.setVariable("anyContestable", root.path("policyFlags").path("isContestable").asBoolean());
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Check contestability (ANY policy) "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_f3</bpmn2:incoming><bpmn2:outgoing>_f4</bpmn2:outgoing><bpmn2:ioSpecification id="_id314"><bpmn2:dataInput id="_SC_CONTEST_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_SC_CONTEST_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_SC_CONTEST_AuthTypeInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_SC_CONTEST_AuthUrlInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_SC_CONTEST_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_SC_CONTEST_ContentDataInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_SC_CONTEST_ContentTypeInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_SC_CONTEST_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_SC_CONTEST_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_SC_CONTEST_HeadersInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_SC_CONTEST_MethodInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_SC_CONTEST_PasswordInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_SC_CONTEST_ReadTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_CONTEST_ReadTimeoutInputXItem" na