<bpmn2:callActivity id="_SC_AGG" drools:independent="true" drools:waitForCompletion="true" name="Aggregate Case_STP_Eligible" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Aggregate Case_STP_Eligible]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-system-claim-process | piid="+kcontext.getProcessInstance().getId()+" | node=Aggregate Case_STP_Eligible");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.putPOJO("claimResults", kcontext.getVariable("claimResults"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
    kcontext.setVariable("caseStpEligible", root.path("caseStpEligible").asBoolean());
    kcontext.setVariable("outcome", root.path("outcome").asText());
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Aggregate Case_STP_Eligible "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_f8</bpmn2:incoming><bpmn2:outgoing>_f9</bpmn2:outgoing><bpmn2:ioSpecification id="_id363"><bpmn2:dataInput id="_SC_AGG_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___SC_AGG_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_SC_AGG_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___SC_AGG_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_SC_AGG_AuthTypeInputX" drools:dtype="" itemSubjectRef="___SC_AGG_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_SC_AGG_AuthUrlInputX" drools:dtype="" itemSubjectRef="___SC_AGG_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_SC_AGG_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_AGG_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_SC_AGG_ContentDataInputX" drools:dtype="" itemSubjectRef="___SC_AGG_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_SC_AGG_ContentTypeInputX" drools:dtype="" itemSubjectRef="___SC_AGG_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_SC_AGG_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___SC_AGG_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_SC_AGG_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___SC_AGG_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_SC_AGG_HeadersInputX" drools:dtype="" itemSubjectRef="___SC_AGG_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_SC_AGG_MethodInputX" drools:dtype="" itemSubjectRef="___SC_AGG_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_SC_AGG_PasswordInputX" drools:dtype="" itemSubjectRef="___SC_AGG_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_SC_AGG_ReadTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_AGG_ReadTimeoutInputXItem" name="ReadTimeout"/><bpmn2:dataInput id="_SC_AGG_ResultClassInputX" drools:dtype="" itemSubjectRef="___SC_