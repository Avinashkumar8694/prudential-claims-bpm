<bpmn2:scriptTask id="_SC_MRX_CHECK" name="All MRX check, Set MRX_Discrepancy Flag" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[All MRX check, Set MRX_Discrepancy Flag]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f5</bpmn2:incoming><bpmn2:outgoing>_f6</bpmn2:outgoing><bpmn2:script><![CDATA[String r=(String)kcontext.getVariable("resPayload");
boolean disc=false;
if(r!=null && !r.isEmpty()){ try{ com.fasterxml.jackson.databind.JsonNode root=new com.fasterxml.jackson.databind.ObjectMapper().readTree(r); com.fasterxml.jackson.databind.JsonNode a=root.path("alerts"); disc = a.isArray() && a.size()>0; }catch(Exception e){} }
kcontext.setVariable("mrxDiscrepancyFlag", disc);]]></bpmn2:script></bpmn2:scriptTask>
