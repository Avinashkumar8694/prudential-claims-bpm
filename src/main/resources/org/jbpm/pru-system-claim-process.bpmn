<bpmn2:callActivity id="_SC_AI" drools:independent="true" drools:waitForCompletion="true" name="Run AI Classification, extraction and validation" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Run AI Classification, extraction and validation]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-system-claim-process | piid="+kcontext.getProcessInstance().getId()+" | node=Run AI Classification, extraction and validation");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Run AI Classification, extraction and validation "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_f13</bpmn2:incoming><bpmn2:outgoing>_f14</bpmn2:outgoing><bpmn2:ioSpecification id="_id469"><bpmn2:dataInput id="_SC_AI_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___SC_AI_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_SC_AI_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___SC_AI_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_SC_AI_AuthTypeInputX" drools:dtype="" itemSubjectRef="___SC_AI_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_SC_AI_AuthUrlInputX" drools:dtype="" itemSubjectRef="___SC_AI_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_SC_AI_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_AI_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_SC_AI_ContentDataInputX" drools:dtype="" itemSubjectRef="___SC_AI_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_SC_AI_ContentTypeInputX" drools:dtype="" itemSubjectRef="___SC_AI_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_SC_AI_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___SC_AI_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_SC_AI_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___SC_AI_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_SC_AI_HeadersInputX" drools:dtype="" itemSubjectRef="___SC_AI_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_SC_AI_MethodInputX" drools:dtype="" itemSubjectRef="___SC_AI_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_SC_AI_PasswordInputX" drools:dtype="" itemSubjectRef="___SC_AI_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_SC_AI_ReadTimeoutInputX" drools:dtype="" itemSubjectRef="___SC_AI_ReadTimeoutInputXItem" name="ReadTimeout"/><bpmn2:dataInput id="_SC_AI_ResultClassInputX" drools:dtype="" itemSubjectRef="___SC_AI_ResultClassInputXItem"