<bpmn2:callActivity id="_V_PROMOTE" drools:independent="true" drools:waitForCompletion="true" name="Set Verified_Promoted + Generate Claim ID" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Set Verified_Promoted + Generate Claim ID]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-verification-process | piid="+kcontext.getProcessInstance().getId()+" | node=Set Verified_Promoted + Generate Claim ID");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.put("notificationStatus","VERIFIED_PROMOTED");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
    kcontext.setVariable("claimId", root.path("claimId").asText());
    kcontext.setVariable("notificationStatus","VERIFIED_PROMOTED");
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Set Verified_Promoted + Generate Claim ID "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_fp</bpmn2:incoming><bpmn2:outgoing>_fp3</bpmn2:outgoing><bpmn2:ioSpecification id="_id150"><bpmn2:dataInput id="_V_PROMOTE_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_V_PROMOTE_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_V_PROMOTE_AuthTypeInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_V_PROMOTE_AuthUrlInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_V_PROMOTE_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_V_PROMOTE_ContentDataInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_V_PROMOTE_ContentTypeInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_V_PROMOTE_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_V_PROMOTE_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_V_PROMOTE_HeadersInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_V_PROMOTE_MethodInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_V_PROMOTE_PasswordInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_V_PROMOTE_ReadTimeoutInputX" drools:dtype="" itemSubjectRef="___V_PROMOTE_ReadTimeoutInputXItem" name="ReadTimeout"/><bpmn2: