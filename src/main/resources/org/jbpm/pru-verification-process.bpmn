<bpmn2:callActivity id="_V_ASSIGN" drools:independent="true" drools:waitForCompletion="true" name="Assign Case to Verifier" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Assign Case to Verifier]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-verification-process | piid="+kcontext.getProcessInstance().getId()+" | node=Assign Case to Verifier");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.put("queue","VERIFICATION");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
    kcontext.setVariable("verifierId", root.path("verifierId").asText());
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Assign Case to Verifier "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_f3</bpmn2:incoming><bpmn2:outgoing>_f4</bpmn2:outgoing><bpmn2:ioSpecification id="_id24"><bpmn2:dataInput id="_V_ASSIGN_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_V_ASSIGN_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_V_ASSIGN_AuthTypeInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_V_ASSIGN_AuthUrlInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_V_ASSIGN_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_V_ASSIGN_ContentDataInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_V_ASSIGN_ContentTypeInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_V_ASSIGN_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_V_ASSIGN_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_V_ASSIGN_HeadersInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_V_ASSIGN_MethodInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_V_ASSIGN_PasswordInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_V_ASSIGN_ReadTimeoutInputX" drools:dtype="" itemSubjectRef="___V_ASSIGN_ReadTimeoutInputXItem" name="ReadTimeout"/><bpmn2:dataInput id="_V_ASSIGN_Resu