<bpmn2:callActivity id="_V_EXTERNAL" drools:independent="true" drools:waitForCompletion="true" name="Run External Verifications" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Run External Verifications]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-verification-process | piid="+kcontext.getProcessInstance().getId()+" | node=Run External Verifications");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.putArray("sources").add("ACURINT").add("DMF").add("OBITUARY").add("TELE_EMAIL");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
    kcontext.setVariable("externalVerificationResult", root.get("results"));
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Run External Verifications "+e.getMessage()); }
