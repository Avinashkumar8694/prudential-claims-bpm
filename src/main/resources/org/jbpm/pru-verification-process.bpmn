<bpmn2:error id="TERMINATE_CASE" errorCode="TERMINATE_CASE"/>
<bpmn2:signal id="_sig_StartSystemClaim" name="StartSystemClaim"/>
  <bpmn2:process id="prudential-claims-submission.pru-verification-process" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-verification-process" isExecutable="true" processType="Public">
<bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
<bpmn2:property id="claimId" itemSubjectRef="_claimIdItem" name="claimId"/>
<bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
<bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
<bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
<bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
<bpmn2:property id="verifierId" itemSubjectRef="_verifierIdItem" name="verifierId"/>
<bpmn2:property id="externalVerificationResult" itemSubjectRef="_externalVerificationResultItem" name="externalVerificationResult"/>
<bpmn2:property id="verificationDecision" itemSubjectRef="_verificationDecisionItem" name="verificationDecision"/>
<bpmn2:property id="notificationStatus" itemSubjectRef="_notificationStatusItem" name="notificationStatus"/>
<bpmn2:sequenceFlow id="_f1" sourceRef="_START" targetRef="_BOOT"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f2" sourceRef="_BOOT" targetRef="_V_STATUS"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f3" sourceRef="_V_STATUS" targetRef="_V_ASSIGN"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f4" sourceRef="_V_ASSIGN" targetRef="_V_REVIEW"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f5" sourceRef="_V_REVIEW" targetRef="_V_EXTERNAL"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f6" sourceRef="_V_EXTERNAL" targetRef="_V_FINDINGS"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f7" sourceRef="_V_FINDINGS" targetRef="_V_BENE"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f8" sourceRef="_V_BENE" targetRef="_V_DECISION"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f9" sourceRef="_V_DECISION" targetRef="_SET_DEC"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_f10" sourceRef="_SET_DEC" targetRef="_XG_DEC"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fp" name="Promote to Claim" sourceRef="_XG_DEC" targetRef="_V_PROMOTE"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Promote to Claim]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "PROMOTE".equals(verificationDecision);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fp3" sourceRef="_V_PROMOTE" targetRef="_V_NOTIFY_PROMO"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fp4" sourceRef="_V_NOTIFY_PROMO" targetRef="_END_PROMOTE"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fh" name="Hold" sourceRef="_XG_DEC" targetRef="_V_HOLD"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Hold]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "HOLD".equals(verificationDecision);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fh3" sourceRef="_V_HOLD" targetRef="_END_HOLD"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fc" name="Close" sourceRef="_XG_DEC" targetRef="_V_CLOSE"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Close]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "CLOSE".equals(verificationDecision);]]></bpmn2:conditionExpression></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fc3" sourceRef="_V_CLOSE" targetRef="_V_NOTIFY_CLOSE"></bpmn2:sequenceFlow>
<bpmn2:sequenceFlow id="_fc4" sourceRef="_V_NOTIFY_CLOSE" targetRef="_END_CLOSE"></bpmn2:sequenceFlow>
<bpmn2:startEvent id="_START" name="Verification Process"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Verification Process]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:outgoing>_f1</bpmn2:outgoing></bpmn2:startEvent>
<bpmn2:scriptTask id="_BOOT" name="Script_Bootstrap" scriptFormat="http://www.java.com/java"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Script_Bootstrap]]></drools:metaValue></drools:metaData></bpmn2:extensionElements><bpmn2:incoming>_f1</bpmn2:incoming><bpmn2:outgoing>_f2</bpmn2:outgoing><bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);
System.out.println("[BPM][BOOTSTRAP] process=pru-verification | piid=" + kcontext.getProcessInstance().getId() + " | baseUrl=" + url);]]></bpmn2:script></bpmn2:scriptTask>
<bpmn2:callActivity id="_V_STATUS" drools:independent="true" drools:waitForCompletion="true" name="Update Case Status For Verification" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Update Case Status For Verification]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-verification-process | piid="+kcontext.getProcessInstance().getId()+" | node=Update Case Status For Verification");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
json.put("status","FOR_VERIFICATION");
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Update Case Status For Verification "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_f2</bpmn2:incoming><bpmn2:outgoing>_f3</bpmn2:outgoing><bpmn2:ioSpecification id="_id3"><bpmn2:dataInput id="_V_STATUS_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___V_STATUS_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_V_STATUS_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___V_STATUS_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_V_STATUS_AuthTypeInputX" drools:dtype="" itemSubjectRef="___V_STATUS_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_V_STATUS_AuthUrlInputX" drools:dtype="" itemSubjectRef="___V_STATUS_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_V_STATUS_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___V_STATUS_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_V_STATUS_ContentDataInputX" drools:dtype="" itemSubjectRef="___V_STATUS_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_V_STATUS_ContentTypeInputX" drools:dtype="" itemSubjectRef="___V_STATUS_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_V_STATUS_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___V_STATUS_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_V_STATUS_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___V_STATUS_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_V_STATUS_HeadersInputX" drools:dtype="" itemSubjectRef="___V_STATUS_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_V_STATUS_MethodInputX" drools:dtype="" itemSubjectRef="___V_STATUS_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_V_STATUS_PasswordInputX" drools:dtype="" itemSubjectRef="___V_STATUS_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_V_STATUS_ReadTimeoutInputX" drools:dtype="" itemSubjectRef="___V_STATUS_ReadTimeoutInputXItem" name="ReadTimeout"/><bpmn2:dataInput id="_V_STATUS_Resul