<bpmn2:callActivity id="_V_NOTIFY_CLOSE" drools:independent="true" drools:waitForCompletion="true" name="Generate and send Closure Notification" calledElement="prudential-claims-submission.pru-rest-executor"><bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Generate and send Closure Notification]]></drools:metaValue></drools:metaData><drools:onEntry-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[System.out.println("[BPM][ENTRY] proc=pru-verification-process | piid="+kcontext.getProcessInstance().getId()+" | node=Generate and send Closure Notification");
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("claimId", kcontext.getVariable("claimId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script></drools:onEntry-script><drools:onExit-script scriptFormat="http://www.java.com/java"><drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");
if (response != null && !response.isEmpty()) {
  try {
    com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Generate and send Closure Notification "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_fc3</bpmn2:incoming><bpmn2:outgoing>_fc4</bpmn2:outgoing><bpmn2:ioSpecification id="_id235"><bpmn2:dataInput id="_V_NOTIFY_CLOSE_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_AuthTypeInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_AuthUrlInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_ContentDataInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_ContentTypeInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_HeadersInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_MethodInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_V_NOTIFY_CLOSE_PasswordInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_CLOSE_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_V_N