  } catch(Exception e) { System.out.println("[BPM][EXIT][ERR] Send email confirmation + claim form "+e.getMessage()); }
}]]></drools:script></drools:onExit-script></bpmn2:extensionElements><bpmn2:incoming>_fp3</bpmn2:incoming><bpmn2:outgoing>_fp4</bpmn2:outgoing><bpmn2:ioSpecification id="_id171"><bpmn2:dataInput id="_V_NOTIFY_PROMO_AcceptCharsetInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_AcceptCharsetInputXItem" name="AcceptCharset"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_AcceptHeaderInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_AcceptHeaderInputXItem" name="AcceptHeader"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_AuthTypeInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_AuthTypeInputXItem" name="AuthType"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_AuthUrlInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_AuthUrlInputXItem" name="AuthUrl"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_ConnectTimeoutInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_ConnectTimeoutInputXItem" name="ConnectTimeout"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_ContentDataInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_ContentDataInputXItem" name="ContentData"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_ContentTypeInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_ContentTypeInputXItem" name="ContentType"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_ContentTypeCharsetInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_ContentTypeCharsetInputXItem" name="ContentTypeCharset"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_HandleResponseErrorsInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_HandleResponseErrorsInputXItem" name="HandleResponseErrors"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_HeadersInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_HeadersInputXItem" name="Headers"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_MethodInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_MethodInputXItem" name="Method"/><bpmn2:dataInput id="_V_NOTIFY_PROMO_PasswordInputX" drools:dtype="" itemSubjectRef="___V_NOTIFY_PROMO_PasswordInputXItem" name="Password"/><bpmn2:dataInput id="_V_N