          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N9a-BeneValidation | caseId=" + kcontext.getVariable("caseId"));
