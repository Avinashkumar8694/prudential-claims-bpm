          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N20-BackupWithholding | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("beneficiarySplit", root.get("beneficiarySplit"));
        System.out.println("[BPM][EXIT][OK] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N20-BackupWithholding | caseId=" + kcontext.getVariable("caseId") + " | beneficiarySplit=" + kcontext.getVariable("beneficiarySplit"));
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N20-BackupWithholding | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
