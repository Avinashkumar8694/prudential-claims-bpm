    <bpmn2:scriptTask id="_9A5E0CF9-2777-47E8-A8F9-A4AF863AAABB" name="Script_CalcContestable" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_CalcContestable]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_P1_F_BANK</bpmn2:incoming>
      <bpmn2:outgoing>_75621A67-AAA3-4784-B2DC-7E4278441839</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("[BPM][CALC_CONTESTABLE] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | caseId=" + kcontext.getVariable("caseId") + " | calculating contestable...");

com.fasterxml.jackson.databind.JsonNode policyFlagsNode = (com.fasterxml.jackson.databind.JsonNode) kcontext.getVariable("policyFlags");
com.fasterxml.jackson.databind.JsonNode beneficiaryFlagsNode = (com.fasterxml.jackson.databind.JsonNode) kcontext.getVariable("beneficiaryFlags");
com.fasterxml.jackson.databind.JsonNode bankValidationResultNode = (com.fasterxml.jackson.databind.JsonNode) kcontext.getVariable("bankValidationResult");
Boolean minorDetectedObj = (Boolean) kcontext.getVariable("minorDetected");
boolean minorDetectedVal = minorDetectedObj != null ? minorDetectedObj.booleanValue() : false;

boolean policyIsActive = false;
boolean policyPremiumsPaid = false;
boolean policyHasLapseAlert = false;

if (policyFlagsNode != null) {
    if (policyFlagsNode.has("isActive")) {
        policyIsActive = policyFlagsNode.get("isActive").asBoolean();
    }
    if (policyFlagsNode.has("premiumsPaid")) {
        policyPremiumsPaid = policyFlagsNode.get("premiumsPaid").asBoolean();
    }
    if (policyFlagsNode.has("hasLapseAlert")) {
        policyHasLapseAlert = policyFlagsNode.get("hasLapseAlert").asBoolean();
    }
}

boolean beneIdentitiesVerified = false;
boolean beneSanctionsChecked = false;

if (beneficiaryFlagsNode != null) {
    if (beneficiaryFlagsNode.has("identitiesVerified")) {
        beneIdentitiesVerified = beneficiaryFlagsNode.get("identitiesVerified").asBoolean();
    }
    if (beneficiaryFlagsNode.has("sanctionsChecked")) {
        beneSanctionsChecked = beneficiaryFlagsNode.get("sanctionsChecked").asBoolean();
    }
}

boolean bankAccountActive = false;
boolean bankOwnerMatch = false;
boolean bankRoutingValid = false;

if (bankValidationResultNode != null) {
    if (bankValidationResultNode.has("accountActive")) {
        bankAccountActive = bankValidationResultNode.get("accountActive").asBoolean();
    }
    if (bankValidationResultNode.has("ownerMatch")) {
        bankOwnerMatch = bankValidationResultNode.get("ownerMatch").asBoolean();
    }
    if (bankValidationResultNode.has("routingValid")) {
        bankRoutingValid = bankValidationResultNode.get("routingValid").asBoolean();
    }
}

boolean contestable =
       !policyIsActive
    || !policyPremiumsPaid
    || policyHasLapseAlert
    || minorDetectedVal
    || !beneIdentitiesVerified
    || !beneSanctionsChecked
    || !bankAccountActive
    || !bankOwnerMatch
    || !bankRoutingValid;

System.out.println("[BPM][CALC_CONTESTABLE] calculated contestable=" + contestable + " (policyIsActive=" + policyIsActive + ", policyPremiumsPaid=" + policyPremiumsPaid + ", policyHasLapseAlert=" + policyHasLapseAlert + ", minorDetectedVal=" + minorDetectedVal + ", beneIdentitiesVerified=" + beneIdentitiesVerified + ", beneSanctionsChecked=" + beneSanctionsChecked + ", bankAccountActive=" + bankAccountActive + ", bankOwnerMatch=" + bankOwnerMatch + ", bankRoutingValid=" + bankRoutingValid + ")");

kcontext.setVariable("flagContestable", contestable);]]></bpmn2:script>
    </bpmn2:scriptTask>
