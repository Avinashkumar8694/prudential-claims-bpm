    <bpmn2:callActivity id="_P1_N1" drools:independent="true" drools:waitForCompletion="true" name="N1: ValidateData" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[N1: ValidateData]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-ValidateData | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-ValidateData | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("policyFlags", root.get("policyFlags"));
        kcontext.setVariable("validationPassed", root.get("validationPassed").asBoolean());
        if (root.has("validationErrors")) {
            java.util.List errors = new com.fasterxml.jackson.databind.ObjectMapper().convertValue(root.get("validationErrors"), java.util.List.class);
            kcontext.setVariable("validationErrors", errors);
        }
        com.fasterxml.jackson.databind.JsonNode flags = root.get("policyFlags");
        if (flags != null) {
            if (flags.has("isSuicide")) kcontext.setVariable("flagSuicide", flags.get("isSuicide").asBoolean());
            if (flags.has("isContestable")) kcontext.setVariable("flagContestable", flags.get("isContestable").asBoolean());
            if (flags.has("isForeignDeath")) kcontext.setVariable("flagForeignDeath", flags.get("isForeignDeath").asBoolean());
            if (flags.has("isAIDS")) kcontext.setVariable("flagAIDS", flags.get("isAIDS").asBoolean());
        }
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-ValidateData | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}]]></drools:script>
        </drools:onExit-script>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
