    <bpmn2:callActivity id="_P1_N22" drools:independent="true" drools:waitForCompletion="true" name="N19: FinalizePayment" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[N19: FinalizePayment]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N22-FinalizePayment | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N23-KNECTPayment | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("finalPaymentInstructions", root.get("finalPaymentInstructions"));
        System.out.println("[BPM][EXIT][OK] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N23-KNECTPayment | caseId=" + kcontext.getVariable("caseId") + " | finalPaymentInstructions=" + kcontext.getVariable("finalPaymentInstructions"));
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N23-KNECTPayment | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}]]></drools:script>
        </drools:onExit-script>
