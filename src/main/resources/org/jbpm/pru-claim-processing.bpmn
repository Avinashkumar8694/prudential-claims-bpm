    <bpmn2:callActivity id="_P1_N6" drools:independent="true" drools:waitForCompletion="true" name="N6: CheckDocCompleteness" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[N6: CheckDocCompleteness]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N6-CheckDocCompleteness | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println(
    "[BPM][EXIT] process=pru-claim-internal | piid="
    + kcontext.getProcessInstance().getId()
    + " | node=N6-CheckDocCompleteness | caseId="
    + kcontext.getVariable("caseId")
    + " | responseLen="
    + (response != null ? response.length() : "null")
);

if (response != null && !response.trim().isEmpty()) {

    try {

        com.fasterxml.jackson.databind.ObjectMapper mapper =
            new com.fasterxml.jackson.databind.ObjectMapper();

        com.fasterxml.jackson.databind.JsonNode root =
            mapper.readTree(response);

        kcontext.setVariable(
            "allDocsVerified",
            root.path("allDocsVerified").asBoolean(false)
        );

        java.util.List<String> docs =
            mapper.convertValue(
                root.path("missingDocs"),
                new com.fasterxml.jackson.core.type.TypeReference<java.util.List<String>>() {}
            );

        kcontext.setVariable("missingDocs", docs);

        System.out.println(
            "[BPM][EXIT][OK] process=pru-claim-internal | piid="
            + kcontext.getProcessInstance().getId()
            + " | node=N6-CheckDocCompleteness | caseId="
            + kcontext.getVariable("caseId")
            + " | missingDocs="
            + docs
        );

    } catch (Exception e) {

        System.out.println(
            "[BPM][EXIT][ERROR] process=pru-claim-internal | piid="
            + kcontext.getProcessInstance().getId()
            + " | node=N6-CheckDocCompleteness | caseId="
            + kcontext.getVariable("caseId")
            + " | error="
            + e.getMessage()
        );
    }

} else {

    kcontext.setVariable(
        "missingDocs",
        new java.util.ArrayList<String>()
    );

    kcontext.setVariable("allDocsVerified", false);

    System.out.println(
        "[BPM][EXIT][WARN] Empty or null resPayload"
    );
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
