      <bpmn2:incoming>_F_BOOTSTRAP</bpmn2:incoming>
      <bpmn2:outgoing>_P1_F1</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try {
        url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL");
    } catch (Exception e) {}
}
if (url == null || url.isEmpty()) {
    url = "http://localhost:3000";
}
kcontext.setVariable("baseUrl", url);

System.out.println("[BPM][BOOTSTRAP] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | caseId=" + kcontext.getVariable("caseId") + " | baseUrl=" + url);
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="_P1_N17" drools:independent="true" drools:waitForCompletion="true" name="N17: CalcBenefit" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[N17: CalcBenefit]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N17-CalcBenefit | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N18-MisstatementAdjust | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("benefitCalculation", root.get("benefitCalculation"));
        kcontext.setVariable("payoutAmount", root.get("payoutAmount").asDouble());
        System.out.println("[BPM][EXIT][OK] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N18-MisstatementAdjust | caseId=" + kcontext.getVariable("caseId") + " | payoutAmount=" + kcontext.getVariable("payoutAmount"));
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-claim-internal | piid=" + kcontext.getProcessInstance().getId() + " | node=N18-MisstatementAdjust | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
