    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_P2_F_TO_WAIT" sourceRef="_P2_MERGE" targetRef="_P2_N4"/>
    <!-- Node 4: Wait for Document Upload (User Task) -->
    <bpmn2:userTask id="_P2_N4" name="Wait for Document Upload" drools:taskName="WaitTask">
      <bpmn2:incoming>_P2_F_TO_WAIT</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F_UPLOADED</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_P2_N4_io">
