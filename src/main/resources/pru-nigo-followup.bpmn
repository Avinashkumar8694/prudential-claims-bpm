        <bpmn2:dataInput id="_P2_N1_Username" name="Username" structureRef="String"/>
        <bpmn2:dataOutput id="_P2_N1_Result" name="Result" structureRef="String"/>
        <bpmn2:inputSet id="_P2_N1_inputSet">
