  <bpmn2:process id="prudential-claims-submission.pru-nigo-followup" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-nigo-followup" isExecutable="true" processType="Public">
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
    <bpmn2:property id="nodeError" itemSubjectRef="_nodeErrorItem" name="nodeError"/>
    <bpmn2:property id="missingDocs" itemSubjectRef="_missingDocsItem" name="missingDocs"/>
    <bpmn2:property id="followupCount" itemSubjectRef="_followupCountItem" name="followupCount"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <bpmn2:property id="reqPayload" itemSubjectRef="_reqPayloadItem" name="reqPayload"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="allDocsReceived" itemSubjectRef="_allDocsReceivedItem" name="allDocsReceived"/>
    <bpmn2:property id="docUploaded" itemSubjectRef="_docUploadedItem" name="docUploaded"/>
    <bpmn2:property id="continueReview" itemSubjectRef="_continueReviewItem" name="continueReview"/>
    <bpmn2:property id="maxAttempts" itemSubjectRef="_maxAttemptsItem" name="maxAttempts"/>
    <bpmn2:property id="applicablePolicies" itemSubjectRef="_applicablePoliciesItem" name="applicablePolicies"/>
    <bpmn2:property id="idpExtractionResult" itemSubjectRef="_idpExtractionResultItem" name="idpExtractionResult"/>
    <bpmn2:property id="verificationStatus" itemSubjectRef="_verificationStatusItem" name="verificationStatus"/>
    <bpmn2:property id="lastReminderDate" itemSubjectRef="_lastReminderDateItem" name="lastReminderDate"/>
    <bpmn2:property id="noticeSentAt" itemSubjectRef="_noticeSentAtItem" name="noticeSentAt"/>
    <bpmn2:property id="noticeS3Key" itemSubjectRef="_noticeS3KeyItem" name="noticeS3Key"/>
    <bpmn2:property id="extractedData" itemSubjectRef="_extractedDataItem" name="extractedData"/>
    <bpmn2:property id="confidenceScores" itemSubjectRef="_confidenceScoresItem" name="confidenceScores"/>
    <bpmn2:property id="pendingDocs" itemSubjectRef="_pendingDocsItem" name="pendingDocs"/>
    <bpmn2:property id="examinerDecision" itemSubjectRef="_examinerDecisionItem" name="examinerDecision"/>
    <bpmn2:property id="claimType" itemSubjectRef="_claimTypeItem" name="claimType"/>
    <bpmn2:sequenceFlow id="_P2_F_UPLOADED" sourceRef="_P2_N4" targetRef="_P2_N6"/>
    <bpmn2:sequenceFlow id="_P2_F_TIMEOUT" sourceRef="_P2_TIMER" targetRef="_P2_INCREMENT"/>
    <bpmn2:sequenceFlow id="_P2_F_IDP_DONE" sourceRef="_P2_N6" targetRef="_P2_N7"/>
    <bpmn2:sequenceFlow id="_P2_F1" sourceRef="_P2_BOOTSTRAP" targetRef="_P2_N1"/>
    <bpmn2:sequenceFlow id="_P2_F_DEATH" name="Death" sourceRef="_P2_XG_CLAIMTYPE" targetRef="_P2_N2A">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Death]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_hw5WgVg5EfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[return "DEATH".equals(claimType);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F2" sourceRef="_P2_N1" targetRef="_P2_XG_CLAIMTYPE"/>
    <bpmn2:sequenceFlow id="_P2_F_DEATH_VER_UPDATED" sourceRef="_P2_N12" targetRef="_P2_N13"/>
    <bpmn2:sequenceFlow id="_P2_F_DEATH_VER_DONE" sourceRef="_P2_N13" targetRef="_P2_END_DEATH_VER"/>
    <bpmn2:sequenceFlow id="_P2_F_TO_WAIT" sourceRef="_P2_MERGE" targetRef="_P2_N4"/>
    <bpmn2:sequenceFlow id="_P2_F_LOOP" sourceRef="_P2_N11" targetRef="_P2_MERGE"/>
    <bpmn2:sequenceFlow id="_P2_F_MERGE_2A" sourceRef="_P2_N2A" targetRef="_P2_MERGE"/>
    <bpmn2:sequenceFlow id="_P2_F_CONTINUE_CHASE" name="Yes" sourceRef="_P2_XG_CONTINUE" targetRef="_P2_MERGE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Yes]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_hw5Wglg5EfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[return "CONTINUE".equals(examinerDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F_REVIEW_DONE" sourceRef="_P2_N9" targetRef="_P2_XG_CONTINUE"/>
    <bpmn2:sequenceFlow id="_F_BOOTSTRAP" sourceRef="_P2_START" targetRef="_P2_BOOTSTRAP"/>
    <bpmn2:sequenceFlow id="_P2_F_DOCS_NO" name="No" sourceRef="_P2_XG_DOCS" targetRef="_P2_N9">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[No]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_hw5Wg1g5EfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[return !Boolean.TRUE.equals(allDocsReceived);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F_STATUS_DONE" sourceRef="_P2_N7" targetRef="_P2_XG_DOCS"/>
    <bpmn2:sequenceFlow id="_P2_F_HALT" name="Limit Reached" sourceRef="_P2_XG_COUNT" targetRef="_P2_N12">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Limit Reached]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_hw5WhFg5EfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[int count = (int) kcontext.getVariable("followupCount");
return count >= 3;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F_RETRY" name="Under Limit" sourceRef="_P2_XG_COUNT" targetRef="_P2_N11">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Under Limit]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_hw5WhVg5EfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[int count = (int) kcontext.getVariable("followupCount");
return count < 3;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
