          <bpmn2:to>_P2_N1_HandleResponseErrors</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P2_N1_HandleResponseErrors</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P2_N1_assoc_ContentData">
        <bpmn2:sourceRef>reqPayload</bpmn2:sourceRef>
        <bpmn2:targetRef>_P2_N1_ContentData</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_P2_N1_assoc_Result">
        <bpmn2:sourceRef>_P2_N1_Result</bpmn2:sourceRef>
        <bpmn2:targetRef>resPayload</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:extensionElements>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-SendNIGO | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("applicablePolicies", kcontext.getVariable("applicablePolicies"));
json.putPOJO("missingDocuments", kcontext.getVariable("missingDocuments"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-SendNIGO | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("noticeSentAt", root.get("noticeSentAt").asText());
        System.out.println("[BPM][EXIT][OK] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-SendNIGO | caseId=" + kcontext.getVariable("caseId") + " | noticeSentAt=" + kcontext.getVariable("noticeSentAt"));
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N1-SendNIGO | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
          <bpmn2:dataInputAssociation id="_P2_N1_assoc_TaskName">
        <bpmn2:targetRef>_P2_N1_TaskName</bpmn2:targetRef>
        <bpmn2:assignment id="_P2_N1_assign_TaskName">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Rest]]></bpmn2:from>
          <bpmn2:to>_P2_N1_TaskName</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="_P2_F2" sourceRef="_P2_N1" targetRef="_P2_XG_CLAIMTYPE"/>
    <!-- Node 2: Exclusive Gateway (Diverging Claim Type Gate) -->
    <bpmn2:exclusiveGateway id="_P2_XG_CLAIMTYPE" name="Claim Type?" gatewayDirection="Diverging">
      <bpmn2:incoming>_P2_F2</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F_DEATH</bpmn2:outgoing>
      <bpmn2:outgoing>_P2_F_TI</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_P2_F_DEATH" name="Death" sourceRef="_P2_XG_CLAIMTYPE" targetRef="_P2_N2A">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return "DEATH".equals(claimType);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F_TI" name="TI" sourceRef="_P2_XG_CLAIMTYPE" targetRef="_P2_N2B">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return !"DEATH".equals(claimType);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <!-- Node 2a: Funding Notice (Death Path) -->
