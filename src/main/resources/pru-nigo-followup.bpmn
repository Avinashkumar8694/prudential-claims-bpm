          <bpmn2:dataInputRefs>_P2_N1_AcceptHeader</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_AuthType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_AuthUrl</bpmn2:dataInputRefs>
