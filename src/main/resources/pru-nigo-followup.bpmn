    <bpmn2:callActivity id="_P2_N6" drools:independent="true" drools:waitForCompletion="true" name="N6: ReRunIDPExtraction" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[N6: ReRunIDPExtraction]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N6-ReRunIDPExtraction | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
json.putPOJO("cid", kcontext.getVariable("cid"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N6-ReRunIDPExtraction | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("idpExtractionResult", root.get("extractionResult"));
        System.out.println("[BPM][EXIT][OK] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N6-ReRunIDPExtraction | caseId=" + kcontext.getVariable("caseId") + " | idpExtractionResult=" + kcontext.getVariable("idpExtractionResult"));
