          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[WaitTask]]></bpmn2:from>
          <bpmn2:to>_P2_N4_TaskNameInput</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="_P2_F_UPLOADED" sourceRef="_P2_N4" targetRef="_P2_N6"/>
    <!-- Node 5: Boundary Timer Event (30 Days) -->
    <bpmn2:boundaryEvent id="_P2_TIMER" name="30 Day Timeout" attachedToRef="_P2_N4" cancelActivity="true">
      <bpmn2:outgoing>_P2_F_TIMEOUT</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="_timerDef2">
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">PT720H</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="_P2_F_TIMEOUT" sourceRef="_P2_TIMER" targetRef="_P2_INCREMENT"/>
    <!-- Increment Follow-up counter on timeout -->
    <bpmn2:scriptTask id="_P2_INCREMENT" name="Script_Increment" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_P2_F_TIMEOUT</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F_TO_XG</bpmn2:outgoing>
      <bpmn2:script>int count = (int) kcontext.getVariable("followupCount");
kcontext.setVariable("followupCount", count + 1);
System.out.println("NIGO: Wait timed out. Incrementing follow-up count to: " + (count + 1));</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="_P2_F_TO_XG" sourceRef="_P2_INCREMENT" targetRef="_P2_XG_COUNT"/>
    <!-- Node 10: Exclusive Gateway (Followup Count Gateway) -->
    <bpmn2:exclusiveGateway id="_P2_XG_COUNT" name="Max Retries?" gatewayDirection="Diverging">
      <bpmn2:incoming>_P2_F_TO_XG</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F_RETRY</bpmn2:outgoing>
      <bpmn2:outgoing>_P2_F_HALT</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_P2_F_RETRY" name="Under Limit" sourceRef="_P2_XG_COUNT" targetRef="_P2_N11">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">int count = (int) kcontext.getVariable("followupCount");
return count &lt; 3;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F_HALT" name="Limit Reached" sourceRef="_P2_XG_COUNT" targetRef="_P2_N12">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[int count = (int) kcontext.getVariable("followupCount");
return count >= 3;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
