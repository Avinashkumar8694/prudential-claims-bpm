          <bpmn2:dataInputRefs>_P2_N1_HandleResponseErrors</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_Headers</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_Method</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_Password</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_ReadTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_ResultClass</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_Url</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_Username</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_P2_N1_outputSet">
          <bpmn2:dataOutputRefs>_P2_N1_Result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:incoming>_P2_F1</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F2</bpmn2:outgoing>
      <bpmn2:dataInputAssociation id="_P2_N1_assoc_Url">
        <bpmn2:assignment id="_P2_N1_assign_Url">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[#{baseUrl}/api/v1/claims/nigo/send]]></bpmn2:from>
          <bpmn2:to>_P2_N1_Url</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P2_N1_Url</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P2_N1_assoc_Method">
        <bpmn2:assignment id="_P2_N1_assign_Method">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[POST]]></bpmn2:from>
          <bpmn2:to>_P2_N1_Method</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P2_N1_Method</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P2_N1_assoc_ContentType">
