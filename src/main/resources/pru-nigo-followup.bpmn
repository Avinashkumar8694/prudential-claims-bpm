      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_6FqdZ1pnEfGoNpO8onZRMw" language="http://www.java.com/java"><![CDATA[int count = (int) kcontext.getVariable("followupCount");
String _claimType = (String) kcontext.getVariable("claimType");
if ("TI".equals(_claimType)) {
    return count < 1;
} else {
    return count < 4;
}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_P2_F_HALT" name="Limit Reached" sourceRef="_P2_XG_COUNT" targetRef="_P2_XG_TIMEOUT_TYPE">
