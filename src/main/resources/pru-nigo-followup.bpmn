        <bpmn2:dataInput id="_P2_N2A_ContentType" name="ContentType" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_ContentTypeCharset" name="ContentTypeCharset" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_HandleResponseErrors" name="HandleResponseErrors" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_Headers" name="Headers" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_Method" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_Password" name="Password" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_ReadTimeout" name="ReadTimeout" structureRef="String"/>
