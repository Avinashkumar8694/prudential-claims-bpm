        <bpmn2:dataInput id="_P2_N2A_Url" name="Url" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N2A_Username" name="Username" structureRef="String"/>
        <bpmn2:dataOutput id="_P2_N2A_Result" name="Result" structureRef="String"/>
        <bpmn2:inputSet id="_P2_N2A_inputSet">
          <bpmn2:dataInputRefs>_P2_N2A_TaskName</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N2A_AcceptCharset</bpmn2:dataInputRefs>
