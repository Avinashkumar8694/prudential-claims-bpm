          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N11-AutoFollowup | caseId=" + kcontext.getVariable("caseId"));
