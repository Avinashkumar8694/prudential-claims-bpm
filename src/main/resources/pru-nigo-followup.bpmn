          <bpmn2:dataOutput id="_P2_ERROR_CALL_out_failedContext" name="failedContext" structureRef="String"/>
          <bpmn2:inputSet id="_P2_ERROR_CALL_input_set">
            <bpmn2:dataInputRefs>_P2_ERROR_CALL_failedContext</bpmn2:dataInputRefs>
            <bpmn2:dataInputRefs>_P2_ERROR_CALL_caseId</bpmn2:dataInputRefs>
          </bpmn2:inputSet>
          <bpmn2:outputSet id="_P2_ERROR_CALL_output_set">
            <bpmn2:dataOutputRefs>_P2_ERROR_CALL_out_failedContext</bpmn2:dataOutputRefs>
          </bpmn2:outputSet>
        </bpmn2:ioSpecification>
        <bpmn2:dataInputAssociation id="_P2_ERROR_CALL_assoc">
          <bpmn2:sourceRef>resPayload</bpmn2:sourceRef>
          <bpmn2:targetRef>_P2_ERROR_CALL_failedContext</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataInputAssociation id="_P2_ERROR_CALL_caseId_assoc">
          <bpmn2:sourceRef>caseId</bpmn2:sourceRef>
          <bpmn2:targetRef>_P2_ERROR_CALL_caseId</bpmn2:targetRef>
        </bpmn2:dataInputAssociation>
        <bpmn2:dataOutputAssociation id="_P2_ERROR_CALL_out_assoc">
          <bpmn2:sourceRef>_P2_ERROR_CALL_out_failedContext</bpmn2:sourceRef>
          <bpmn2:targetRef>resPayload</bpmn2:targetRef>
        </bpmn2:dataOutputAssociation>
      </bpmn2:callActivity>
      <bpmn2:sequenceFlow id="_P2_ERR_F2" sourceRef="_P2_ERROR_CALL" targetRef="_P2_ERROR_END"/>
      <bpmn2:endEvent id="_P2_ERROR_END" name="End Error Catch">
