        <bpmn2:dataInput id="_P2_N1_HandleResponseErrors" name="HandleResponseErrors" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N1_Headers" name="Headers" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N1_Method" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N1_Password" name="Password" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N1_ReadTimeout" name="ReadTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_P2_N1_ResultClass" name="ResultClass" structureRef="String"/>
