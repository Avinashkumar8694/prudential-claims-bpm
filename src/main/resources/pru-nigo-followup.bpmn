    <bpmn2:scriptTask id="_P2_BOOTSTRAP" name="Script_Bootstrap" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_Bootstrap]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_F_BOOTSTRAP</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F1</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try {
        url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL");
    } catch (Exception e) {}
}
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);
kcontext.setVariable("followupCount", 0);
kcontext.setVariable("maxAttempts", 4);

// Dynamic determination of claimType if not provided
if (kcontext.getVariable("claimType") == null) {
    kcontext.setVariable("claimType", "DEATH");
}
System.out.println("NIGO: Bootstrapped. Base URL = " + url + ", Claim Type = " + kcontext.getVariable("claimType"));]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_P2_INCREMENT" name="Script_Increment" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_Increment]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_P2_F_TIMEOUT</bpmn2:incoming>
      <bpmn2:outgoing>_P2_F_TO_XG</bpmn2:outgoing>
      <bpmn2:script><![CDATA[int count = (int) kcontext.getVariable("followupCount");
kcontext.setVariable("followupCount", count + 1);
System.out.println("NIGO: Wait timed out. Incrementing follow-up count to: " + (count + 1));]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="_P2_N7" drools:independent="true" drools:waitForCompletion="true" name="N7: UpdateClaimStatus" calledElement="prudential-claims-submission.pru-rest-executor">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[N7: UpdateClaimStatus]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[System.out.println("[BPM][ENTRY] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N7-UpdateClaimStatus | caseId=" + kcontext.getVariable("caseId"));
com.fasterxml.jackson.databind.node.ObjectNode json = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
json.put("piid", String.valueOf(kcontext.getProcessInstance().getId()));
json.putPOJO("caseId", kcontext.getVariable("caseId"));
kcontext.setVariable("reqPayload", json.toString());]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[String response = (String) kcontext.getVariable("resPayload");

System.out.println("[BPM][EXIT] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N7-UpdateClaimStatus | caseId=" + kcontext.getVariable("caseId") + " | responseLen=" + (response != null ? String.valueOf(response.length()) : "null"));
if (response != null && !response.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode root = new com.fasterxml.jackson.databind.ObjectMapper().readTree(response);
        kcontext.setVariable("allDocsReceived", root.get("allDocsReceived").asBoolean());
        System.out.println("[BPM][EXIT][OK] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N7-UpdateClaimStatus | caseId=" + kcontext.getVariable("caseId") + " | allDocsReceived=" + kcontext.getVariable("allDocsReceived"));
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-nigo-followup | piid=" + kcontext.getProcessInstance().getId() + " | node=N7-UpdateClaimStatus | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
