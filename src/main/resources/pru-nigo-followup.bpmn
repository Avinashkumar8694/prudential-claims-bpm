          <bpmn2:dataInputRefs>_P2_N1_Content</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_ContentData</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_P2_N1_ContentType</bpmn2:dataInputRefs>
