          <bpmn2:to>_P2_N1_ContentType</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_P2_N1_ContentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_P2_N1_assoc_HandleResponseErrors">
