<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/bpmn20" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_proc3_def" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_failedEndpointItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_failedPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_retryCountItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_maxRetryCountItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_failedContextItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_resPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_baseUrlItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_retrySuccessItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_adminDecisionItem" structureRef="String"/>
  
  <bpmn2:error id="REST_API_FAILURE" errorCode="REST_API_FAILURE"/>

  <bpmn2:process id="prudential-claims-submission.pru-api-error-handler" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-api-error-handler" isExecutable="true" processType="Public">
    <bpmn2:property id="failedEndpoint" itemSubjectRef="_failedEndpointItem" name="failedEndpoint"/>
    <bpmn2:property id="failedPayload" itemSubjectRef="_failedPayloadItem" name="failedPayload"/>
    <bpmn2:property id="retryCount" itemSubjectRef="_retryCountItem" name="retryCount"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
    <bpmn2:property id="failedContext" itemSubjectRef="_failedContextItem" name="failedContext"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <bpmn2:property id="retrySuccess" itemSubjectRef="_retrySuccessItem" name="retrySuccess"/>
    <bpmn2:property id="adminDecision" itemSubjectRef="_adminDecisionItem" name="adminDecision"/>
    
    <!-- Nodes -->
    <bpmn2:startEvent id="_START_NODE" name="Start Error Handler">
      <bpmn2:outgoing>_flow1</bpmn2:outgoing>
    </bpmn2:startEvent>
    
    <bpmn2:sequenceFlow id="_flow1" sourceRef="_START_NODE" targetRef="_PARSE_SCRIPT"/>
    
    <!-- Script Node to unpack exception details -->
    <bpmn2:scriptTask id="_PARSE_SCRIPT" name="Script_ParseContext" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_flow1</bpmn2:incoming>
      <bpmn2:outgoing>_flow2</bpmn2:outgoing>
      <bpmn2:script><![CDATA[// 1. Initialize Base URL
String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try {
        url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL");
    } catch (Exception e) {}
}
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);

// 2. Initialize default retry states if empty
if (kcontext.getVariable("retryCount") == null) { kcontext.setVariable("retryCount", 0); }
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", 3); }

// 3. Unpack the JSON context sent from the main process
String ctx = (String) kcontext.getVariable("failedContext");
if (ctx != null && !ctx.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode node = new com.fasterxml.jackson.databind.ObjectMapper().readTree(ctx);
        String endpoint = node.get("url").asText();
        if (!endpoint.startsWith("http")) {
            endpoint = url + endpoint;
        }
        kcontext.setVariable("failedEndpoint", endpoint);
        kcontext.setVariable("failedPayload", node.get("payload").toString());
    } catch(Exception e) {
        System.out.println("Error parsing context: " + e.getMessage());
    }
}]]></bpmn2:script>
    </bpmn2:scriptTask>
    
    <bpmn2:sequenceFlow id="_flow2" sourceRef="_PARSE_SCRIPT" targetRef="_TIMER_NODE"/>
    
    <!-- Intermediate catch timer: 15 minutes backoff -->
    <bpmn2:intermediateCatchEvent id="_TIMER_NODE" name="Timer_15mWait">
      <bpmn2:incoming>_flow2</bpmn2:incoming>
      <bpmn2:incoming>_flow_retry_loop</bpmn2:incoming>
      <bpmn2:outgoing>_flow3</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="_timerDef">
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression" id="_duration">PT15M</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>
    
    <bpmn2:sequenceFlow id="_flow3" sourceRef="_TIMER_NODE" targetRef="_RETRY_REST"/>
    
    <!-- Retry the REST API dynamically -->
    <bpmn2:task id="_RETRY_REST" drools:taskName="Rest" name="Rest_RetryAPI">
      <bpmn2:incoming>_flow3</bpmn2:incoming>
      <bpmn2:incoming>_flow_admin_retry</bpmn2:incoming>
      <bpmn2:outgoing>_flow4</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_io1">
        <bpmn2:dataInput id="_urlIn" name="Url" itemSubjectRef="_failedEndpointItem"/>
        <bpmn2:dataInput id="_methodIn" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_dataIn" name="ContentData" itemSubjectRef="_failedPayloadItem"/>
        <bpmn2:dataOutput id="_resOut" name="Result" itemSubjectRef="_resPayloadItem"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_urlIn</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_methodIn</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_dataIn</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_oset2">
          <bpmn2:dataOutputRefs>_resOut</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_assoc2">
        <bpmn2:sourceRef>failedEndpoint</bpmn2:sourceRef>
        <bpmn2:targetRef>_urlIn</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_assoc3">
        <bpmn2:targetRef>_methodIn</bpmn2:targetRef>
        <bpmn2:assignment id="_assign1">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[POST]]></bpmn2:from>
          <bpmn2:to>_methodIn</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_assoc4">
        <bpmn2:sourceRef>failedPayload</bpmn2:sourceRef>
        <bpmn2:targetRef>_dataIn</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_assoc5">
        <bpmn2:sourceRef>_resOut</bpmn2:sourceRef>
        <bpmn2:targetRef>resPayload</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    
    <bpmn2:sequenceFlow id="_flow4" sourceRef="_RETRY_REST" targetRef="_CHECK_SUCCESS"/>
    
    <!-- Exclusive Gateway: Success? -->
    <bpmn2:exclusiveGateway id="_CHECK_SUCCESS" name="Success?" gatewayDirection="Diverging">
      <bpmn2:incoming>_flow4</bpmn2:incoming>
      <bpmn2:outgoing>_flow_success_end</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_fail_increment</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    
    <bpmn2:sequenceFlow id="_flow_success_end" name="Yes" sourceRef="_CHECK_SUCCESS" targetRef="_END_NODE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return resPayload != null && !resPayload.isEmpty();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="_flow_fail_increment" name="No" sourceRef="_CHECK_SUCCESS" targetRef="_INCREMENT_RETRY">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return resPayload == null || resPayload.isEmpty();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <!-- Script Task: Increment retryCount -->
    <bpmn2:scriptTask id="_INCREMENT_RETRY" name="Increment retryCount" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_flow_fail_increment</bpmn2:incoming>
      <bpmn2:outgoing>_flow_check_limit</bpmn2:outgoing>
      <bpmn2:script><![CDATA[int count = (int) kcontext.getVariable("retryCount");
kcontext.setVariable("retryCount", count + 1);
System.out.println("Error Handler: API Retry failed. Attempt: " + (count + 1));]]></bpmn2:script>
    </bpmn2:scriptTask>
    
    <bpmn2:sequenceFlow id="_flow_check_limit" sourceRef="_INCREMENT_RETRY" targetRef="_CHECK_LIMIT"/>
    
    <!-- Exclusive Gateway: Check max retry limit -->
    <bpmn2:exclusiveGateway id="_CHECK_LIMIT" name="retryCount &lt; maxRetryCount?" gatewayDirection="Diverging">
      <bpmn2:incoming>_flow_check_limit</bpmn2:incoming>
      <bpmn2:outgoing>_flow_retry_loop</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_limit_exceeded</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    
    <bpmn2:sequenceFlow id="_flow_retry_loop" name="Yes" sourceRef="_CHECK_LIMIT" targetRef="_TIMER_NODE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return retryCount < maxRetryCount;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="_flow_limit_exceeded" name="No" sourceRef="_CHECK_LIMIT" targetRef="_ADMIN_REVIEW">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return retryCount >= maxRetryCount;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <!-- User Task: IT Administrator review -->
    <bpmn2:userTask id="_ADMIN_REVIEW" name="IT Admin Exception Review">
      <bpmn2:incoming>_flow_limit_exceeded</bpmn2:incoming>
      <bpmn2:outgoing>_flow_admin_action</bpmn2:outgoing>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression><![CDATA[SystemAdmin]]></bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>
    
    <bpmn2:sequenceFlow id="_flow_admin_action" sourceRef="_ADMIN_REVIEW" targetRef="_ADMIN_DECISION_GATE"/>
    
    <!-- Gateway: Admin Decision -->
    <bpmn2:exclusiveGateway id="_ADMIN_DECISION_GATE" name="Admin Action?" gatewayDirection="Diverging">
      <bpmn2:incoming>_flow_admin_action</bpmn2:incoming>
      <bpmn2:outgoing>_flow_admin_retry</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_admin_skip</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_admin_terminate</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    
    <bpmn2:sequenceFlow id="_flow_admin_retry" name="Force Retry" sourceRef="_ADMIN_DECISION_GATE" targetRef="_RETRY_REST">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "RETRY".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="_flow_admin_skip" name="Skip Node" sourceRef="_ADMIN_DECISION_GATE" targetRef="_END_NODE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "SKIP".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    
    <bpmn2:sequenceFlow id="_flow_admin_terminate" name="Terminate Case" sourceRef="_ADMIN_DECISION_GATE" targetRef="_END_TERMINATE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "TERMINATE".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <!-- Normal End Node -->
    <bpmn2:endEvent id="_END_NODE" name="End (Resume)">
      <bpmn2:incoming>_flow_success_end</bpmn2:incoming>
      <bpmn2:incoming>_flow_admin_skip</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- Terminate End Node -->
    <bpmn2:endEvent id="_END_TERMINATE" name="End (Terminate)">
      <bpmn2:incoming>_flow_admin_terminate</bpmn2:incoming>
    </bpmn2:endEvent>
    
  </bpmn2:process>
  
  <!-- Complete Visual layout block matching coords -->
  <bpmndi:BPMNDiagram id="_DI_PLAN">
    <bpmndi:BPMNPlane id="_DI_PLANE" bpmnElement="prudential-claims-submission.pru-api-error-handler">
       <!-- Node shapes -->
       <bpmndi:BPMNShape id="_S1" bpmnElement="_START_NODE">
          <dc:Bounds height="56.0" width="56.0" x="50.0" y="100.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S2" bpmnElement="_PARSE_SCRIPT">
          <dc:Bounds height="80.0" width="120.0" x="150.0" y="88.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S3" bpmnElement="_TIMER_NODE">
          <dc:Bounds height="56.0" width="56.0" x="320.0" y="100.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S4" bpmnElement="_RETRY_REST">
          <dc:Bounds height="80.0" width="120.0" x="420.0" y="88.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S_CHECK_SUCCESS" bpmnElement="_CHECK_SUCCESS">
          <dc:Bounds height="50.0" width="50.0" x="580.0" y="103.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S_INCREMENT_RETRY" bpmnElement="_INCREMENT_RETRY">
          <dc:Bounds height="80.0" width="120.0" x="545.0" y="220.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S_CHECK_LIMIT" bpmnElement="_CHECK_LIMIT">
          <dc:Bounds height="50.0" width="50.0" x="700.0" y="235.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S_ADMIN_REVIEW" bpmnElement="_ADMIN_REVIEW">
          <dc:Bounds height="80.0" width="120.0" x="800.0" y="220.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S_ADMIN_DECISION_GATE" bpmnElement="_ADMIN_DECISION_GATE">
          <dc:Bounds height="50.0" width="50.0" x="960.0" y="235.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S5" bpmnElement="_END_NODE">
          <dc:Bounds height="56.0" width="56.0" x="850.0" y="100.0"/>
       </bpmndi:BPMNShape>
       <bpmndi:BPMNShape id="_S_END_TERMINATE" bpmnElement="_END_TERMINATE">
          <dc:Bounds height="56.0" width="56.0" x="1060.0" y="232.0"/>
       </bpmndi:BPMNShape>

       <!-- Edges -->
       <bpmndi:BPMNEdge id="_E1" bpmnElement="_flow1">
          <di:waypoint x="106.0" y="128.0"/><di:waypoint x="150.0" y="128.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E2" bpmnElement="_flow2">
          <di:waypoint x="270.0" y="128.0"/><di:waypoint x="320.0" y="128.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E3" bpmnElement="_flow3">
          <di:waypoint x="376.0" y="128.0"/><di:waypoint x="420.0" y="128.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E4" bpmnElement="_flow4">
          <di:waypoint x="540.0" y="128.0"/><di:waypoint x="580.0" y="128.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_SUCCESS_END" bpmnElement="_flow_success_end">
          <di:waypoint x="630.0" y="128.0"/><di:waypoint x="850.0" y="128.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_FAIL_INC" bpmnElement="_flow_fail_increment">
          <di:waypoint x="605.0" y="153.0"/><di:waypoint x="605.0" y="220.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_CHECK_LIMIT" bpmnElement="_flow_check_limit">
          <di:waypoint x="665.0" y="260.0"/><di:waypoint x="700.0" y="260.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_RETRY_LOOP" bpmnElement="_flow_retry_loop">
          <di:waypoint x="725.0" y="285.0"/>
          <di:waypoint x="725.0" y="340.0"/>
          <di:waypoint x="348.0" y="340.0"/>
          <di:waypoint x="348.0" y="156.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_LIMIT_EXCEEDED" bpmnElement="_flow_limit_exceeded">
          <di:waypoint x="750.0" y="260.0"/><di:waypoint x="800.0" y="260.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_ADMIN_ACTION" bpmnElement="_flow_admin_action">
          <di:waypoint x="920.0" y="260.0"/><di:waypoint x="960.0" y="260.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_ADMIN_RETRY" bpmnElement="_flow_admin_retry">
          <di:waypoint x="985.0" y="235.0"/>
          <di:waypoint x="985.0" y="-30.0"/>
          <di:waypoint x="480.0" y="-30.0"/>
          <di:waypoint x="480.0" y="88.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_ADMIN_SKIP" bpmnElement="_flow_admin_skip">
          <di:waypoint x="985.0" y="285.0"/>
          <di:waypoint x="985.0" y="340.0"/>
          <di:waypoint x="878.0" y="340.0"/>
          <di:waypoint x="878.0" y="156.0"/>
       </bpmndi:BPMNEdge>
       <bpmndi:BPMNEdge id="_E_ADMIN_TERMINATE" bpmnElement="_flow_admin_terminate">
          <di:waypoint x="1010.0" y="260.0"/><di:waypoint x="1060.0" y="260.0"/>
       </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
