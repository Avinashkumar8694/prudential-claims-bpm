<?xml version='1.0' encoding='UTF-8'?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/bpmn20" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_proc3_def" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_failedEndpointItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_failedPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_retryCountItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_maxRetryCountItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_failedContextItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_resPayloadItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_baseUrlItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_retrySuccessItem" structureRef="java.lang.Boolean"/>
  <bpmn2:itemDefinition id="_adminDecisionItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_failedMethodItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_caseIdItem" structureRef="String"/>
  <bpmn2:error id="REST_API_FAILURE" errorCode="org.jbpm.bpmn2.handler.WorkItemHandlerRuntimeException"/>
  <bpmn2:process id="prudential-claims-submission.pru-api-error-handler" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-api-error-handler" isExecutable="true" processType="Public">
    <bpmn2:property id="failedEndpoint" itemSubjectRef="_failedEndpointItem" name="failedEndpoint"/>
    <bpmn2:property id="failedPayload" itemSubjectRef="_failedPayloadItem" name="failedPayload"/>
    <bpmn2:property id="retryCount" itemSubjectRef="_retryCountItem" name="retryCount"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
    <bpmn2:property id="failedContext" itemSubjectRef="_failedContextItem" name="failedContext"/>
    <bpmn2:property id="resPayload" itemSubjectRef="_resPayloadItem" name="resPayload"/>
    <bpmn2:property id="baseUrl" itemSubjectRef="_baseUrlItem" name="baseUrl"/>
    <bpmn2:property id="retrySuccess" itemSubjectRef="_retrySuccessItem" name="retrySuccess"/>
    <bpmn2:property id="adminDecision" itemSubjectRef="_adminDecisionItem" name="adminDecision"/>
    <bpmn2:property id="failedMethod" itemSubjectRef="_failedMethodItem" name="failedMethod"/>
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <!-- Nodes -->
    <bpmn2:startEvent id="_START_NODE" name="Start Error Handler">
      <bpmn2:outgoing>_flow1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="_flow1" sourceRef="_START_NODE" targetRef="_PARSE_SCRIPT"/>
    <!-- Script Node to unpack exception details -->
    <bpmn2:scriptTask id="_PARSE_SCRIPT" name="Script_ParseContext" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_flow1</bpmn2:incoming>
      <bpmn2:outgoing>_flow2</bpmn2:outgoing>
      <bpmn2:script>// 1. Initialize Base URL
String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try {
        url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL");
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);

System.out.println("[BPM][BOOTSTRAP] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | caseId=" + kcontext.getVariable("caseId") + " | baseUrl=" + url);

// 2. Initialize default retry states if empty
if (kcontext.getVariable("retryCount") == null) { kcontext.setVariable("retryCount", 0); }
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", 3); }

// 3. Unpack the JSON context sent from the main process
String ctx = (String) kcontext.getVariable("failedContext");

System.out.println("[BPM][ENTRY] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | failedContext=" + (ctx != null ? ctx.substring(0, Math.min(ctx.length(), 200)) : "null"));
if (ctx != null &amp;&amp; !ctx.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode node = new com.fasterxml.jackson.databind.ObjectMapper().readTree(ctx);
        String endpoint = node.get("url").asText();
        if (!endpoint.startsWith("http")) {
            endpoint = url + endpoint;
        }
        kcontext.setVariable("failedEndpoint", endpoint);
        kcontext.setVariable("failedPayload", node.get("payload").toString());

        System.out.println("[BPM][EXIT][OK] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | failedEndpoint=" + endpoint);
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="_flow2" sourceRef="_PARSE_SCRIPT" targetRef="_TIMER_MERGE"/>
    <bpmn2:exclusiveGateway id="_TIMER_MERGE" name="Timer Merge" gatewayDirection="Converging">
      <bpmn2:incoming>_flow2</bpmn2:incoming>
      <bpmn2:incoming>_flow_retry_loop</bpmn2:incoming>
      <bpmn2:outgoing>_flow_to_timer</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_flow_to_timer" sourceRef="_TIMER_MERGE" targetRef="_TIMER_NODE"/>
    <!-- Intermediate catch timer: 1 minute backoff -->
    <bpmn2:intermediateCatchEvent id="_TIMER_NODE" name="Timer_1mWait">
      <bpmn2:incoming>_flow_to_timer</bpmn2:incoming>
      <bpmn2:outgoing>_flow3</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="_timerDef">
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression" id="_duration">PT1M</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:sequenceFlow id="_flow3" sourceRef="_TIMER_NODE" targetRef="_RETRY_MERGE"/>
    <bpmn2:exclusiveGateway id="_RETRY_MERGE" name="Retry Merge" gatewayDirection="Converging">
      <bpmn2:incoming>_flow3</bpmn2:incoming>
      <bpmn2:incoming>_flow_admin_retry</bpmn2:incoming>
      <bpmn2:outgoing>_flow_to_retry</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_flow_to_retry" sourceRef="_RETRY_MERGE" targetRef="_RETRY_REST"/>
    <!-- Retry the REST API dynamically -->
    <bpmn2:task id="_RETRY_REST" drools:taskName="Rest" name="Rest_RetryAPI">
      <bpmn2:ioSpecification id="_RETRY_REST_io">
        <bpmn2:dataInput id="_RETRY_REST_TaskName" name="TaskName" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_AcceptCharset" name="AcceptCharset" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_AcceptHeader" name="AcceptHeader" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_AuthType" name="AuthType" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_AuthUrl" name="AuthUrl" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_ConnectTimeout" name="ConnectTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_Content" name="Content" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_ContentData" name="ContentData" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_ContentType" name="ContentType" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_ContentTypeCharset" name="ContentTypeCharset" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_HandleResponseErrors" name="HandleResponseErrors" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_Headers" name="Headers" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_Method" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_Password" name="Password" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_ReadTimeout" name="ReadTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_ResultClass" name="ResultClass" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_Url" name="Url" structureRef="String"/>
        <bpmn2:dataInput id="_RETRY_REST_Username" name="Username" structureRef="String"/>
        <bpmn2:dataOutput id="_RETRY_REST_Result" name="Result" structureRef="String"/>
        <bpmn2:inputSet id="_RETRY_REST_inputSet">
          <bpmn2:dataInputRefs>_RETRY_REST_TaskName</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_AcceptCharset</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_AcceptHeader</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_AuthType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_AuthUrl</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_ConnectTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_Content</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_ContentData</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_ContentType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_ContentTypeCharset</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_HandleResponseErrors</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_Headers</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_Method</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_Password</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_ReadTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_ResultClass</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_Url</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_RETRY_REST_Username</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_RETRY_REST_outputSet">
          <bpmn2:dataOutputRefs>_RETRY_REST_Result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:incoming>_flow_to_retry</bpmn2:incoming>
      <bpmn2:outgoing>_flow4</bpmn2:outgoing>
      <bpmn2:dataInputAssociation id="_RETRY_REST_assoc_Url">
        <bpmn2:sourceRef>failedEndpoint</bpmn2:sourceRef>
        <bpmn2:targetRef>_RETRY_REST_Url</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_RETRY_REST_assoc_Method">
        <bpmn2:sourceRef>failedMethod</bpmn2:sourceRef>
        <bpmn2:targetRef>_RETRY_REST_Method</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_RETRY_REST_assoc_ContentData">
        <bpmn2:sourceRef>failedPayload</bpmn2:sourceRef>
        <bpmn2:targetRef>_RETRY_REST_ContentData</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_RETRY_REST_assoc_ContentType">
        <bpmn2:assignment id="_RETRY_REST_assign_ContentType">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[application/json]]></bpmn2:from>
          <bpmn2:to>_RETRY_REST_ContentType</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_RETRY_REST_ContentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_RETRY_REST_assoc_HandleResponseErrors">
        <bpmn2:assignment id="_RETRY_REST_assign_HandleResponseErrors">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[true]]></bpmn2:from>
          <bpmn2:to>_RETRY_REST_HandleResponseErrors</bpmn2:to>
        </bpmn2:assignment>
        <bpmn2:targetRef>_RETRY_REST_HandleResponseErrors</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_RETRY_REST_assoc_Result">
        <bpmn2:sourceRef>_RETRY_REST_Result</bpmn2:sourceRef>
        <bpmn2:targetRef>resPayload</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
          <bpmn2:dataInputAssociation id="_RETRY_REST_assoc_TaskName">
        <bpmn2:targetRef>_RETRY_REST_TaskName</bpmn2:targetRef>
        <bpmn2:assignment id="_RETRY_REST_assign_TaskName">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[Rest]]></bpmn2:from>
          <bpmn2:to>_RETRY_REST_TaskName</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="_flow4" sourceRef="_RETRY_REST" targetRef="_CHECK_SUCCESS"/>
    <!-- Exclusive Gateway: Success? -->
    <bpmn2:exclusiveGateway id="_CHECK_SUCCESS" name="Success?" gatewayDirection="Diverging">
      <bpmn2:incoming>_flow4</bpmn2:incoming>
      <bpmn2:outgoing>_flow_success_end</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_fail_increment</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_flow_success_end" name="Yes" sourceRef="_CHECK_SUCCESS" targetRef="_END_MERGE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return resPayload != null &amp;&amp; !resPayload.isEmpty();</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_fail_increment" name="No" sourceRef="_CHECK_SUCCESS" targetRef="_INCREMENT_RETRY">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return resPayload == null || resPayload.isEmpty();</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <!-- Script Task: Increment retryCount -->
    <bpmn2:scriptTask id="_INCREMENT_RETRY" name="Increment retryCount" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_flow_fail_increment</bpmn2:incoming>
      <bpmn2:outgoing>_flow_check_limit</bpmn2:outgoing>
      <bpmn2:script>int count = (int) kcontext.getVariable("retryCount");
kcontext.setVariable("retryCount", count + 1);

System.out.println("[BPM][RETRY] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=IncrementRetry | caseId=" + kcontext.getVariable("caseId") + " | attempt=" + (count + 1) + " | maxRetries=" + kcontext.getVariable("maxRetryCount") + " | failedEndpoint=" + kcontext.getVariable("failedEndpoint"));
</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="_flow_check_limit" sourceRef="_INCREMENT_RETRY" targetRef="_CHECK_LIMIT"/>
    <!-- Exclusive Gateway: Check max retry limit -->
    <bpmn2:exclusiveGateway id="_CHECK_LIMIT" name="retryCount &lt; maxRetryCount?" gatewayDirection="Diverging">
      <bpmn2:incoming>_flow_check_limit</bpmn2:incoming>
      <bpmn2:outgoing>_flow_retry_loop</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_limit_exceeded</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_flow_retry_loop" name="Yes" sourceRef="_CHECK_LIMIT" targetRef="_TIMER_MERGE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return retryCount &lt; maxRetryCount;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_limit_exceeded" name="No" sourceRef="_CHECK_LIMIT" targetRef="_ADMIN_REVIEW">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return retryCount &gt;= maxRetryCount;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <!-- User Task: IT Administrator review -->
    <bpmn2:userTask id="_ADMIN_REVIEW" name="IT Admin Exception Review">
      <bpmn2:incoming>_flow_limit_exceeded</bpmn2:incoming>
      <bpmn2:outgoing>_flow_admin_action</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_ADMIN_REVIEW_io">
        <bpmn2:dataInput id="_ADMIN_REVIEW_TaskNameInputX" name="TaskName" structureRef="Object"/>
        <bpmn2:dataInput id="_ADMIN_REVIEW_SkippableInputX" name="Skippable" structureRef="Object"/>
        <bpmn2:dataOutput id="_ADMIN_REVIEW_decisionOutput" name="adminDecision" structureRef="String"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_ADMIN_REVIEW_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_ADMIN_REVIEW_SkippableInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_ADMIN_REVIEW_decisionOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_ADMIN_REVIEW_assoc_TaskName">
        <bpmn2:targetRef>_ADMIN_REVIEW_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_ADMIN_REVIEW_assign_TaskName">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ITAdminExceptionReview]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_ADMIN_REVIEW_TaskNameInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_ADMIN_REVIEW_assoc_Skippable">
        <bpmn2:targetRef>_ADMIN_REVIEW_SkippableInputX</bpmn2:targetRef>
        <bpmn2:assignment id="_ADMIN_REVIEW_assign_Skippable">
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_ADMIN_REVIEW_SkippableInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_ADMIN_REVIEW_assoc_decision">
        <bpmn2:sourceRef>_ADMIN_REVIEW_decisionOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>adminDecision</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression>SystemAdmin</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="_flow_admin_action" sourceRef="_ADMIN_REVIEW" targetRef="_ADMIN_DECISION_GATE"/>
    <!-- Gateway: Admin Decision -->
    <bpmn2:exclusiveGateway id="_ADMIN_DECISION_GATE" name="Admin Action?" gatewayDirection="Diverging">
      <bpmn2:incoming>_flow_admin_action</bpmn2:incoming>
      <bpmn2:outgoing>_flow_admin_retry</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_admin_skip</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_admin_terminate</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_flow_admin_retry" name="Force Retry" sourceRef="_ADMIN_DECISION_GATE" targetRef="_RETRY_MERGE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return "RETRY".equals(adminDecision);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_admin_skip" name="Skip Node" sourceRef="_ADMIN_DECISION_GATE" targetRef="_END_MERGE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return "SKIP".equals(adminDecision);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_admin_terminate" name="Terminate Case" sourceRef="_ADMIN_DECISION_GATE" targetRef="_END_TERMINATE">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return "TERMINATE".equals(adminDecision);</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:exclusiveGateway id="_END_MERGE" name="End Merge" gatewayDirection="Converging">
      <bpmn2:incoming>_flow_success_end</bpmn2:incoming>
      <bpmn2:incoming>_flow_admin_skip</bpmn2:incoming>
      <bpmn2:outgoing>_flow_to_end_resume</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="_flow_to_end_resume" sourceRef="_END_MERGE" targetRef="_END_NODE"/>
    <!-- Normal End Node -->
    <bpmn2:endEvent id="_END_NODE" name="End (Resume)">
      <bpmn2:incoming>_flow_to_end_resume</bpmn2:incoming>
    </bpmn2:endEvent>
    <!-- Terminate End Node -->
    <bpmn2:endEvent id="_END_TERMINATE" name="End (Terminate)">
      <bpmn2:incoming>_flow_admin_terminate</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <!-- Complete Visual layout block matching coords -->
  <bpmndi:BPMNDiagram id="_DI_PLAN">
    <bpmndi:BPMNPlane id="_DI_PLANE" bpmnElement="prudential-claims-submission.pru-api-error-handler">
      <!-- Node shapes -->
      <bpmndi:BPMNShape id="_S1" bpmnElement="_START_NODE">
        <dc:Bounds height="56.0" width="56.0" x="50.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S2" bpmnElement="_PARSE_SCRIPT">
        <dc:Bounds height="80.0" width="120.0" x="150.0" y="88.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_TIMER_MERGE" bpmnElement="_TIMER_MERGE">
        <dc:Bounds height="50.0" width="50.0" x="280.0" y="103.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S3" bpmnElement="_TIMER_NODE">
        <dc:Bounds height="56.0" width="56.0" x="350.0" y="100.0"/>
      </bpmndi:BPMNShape>
