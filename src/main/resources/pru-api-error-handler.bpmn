    <bpmn2:property id="failedMethod" itemSubjectRef="_failedMethodItem" name="failedMethod"/>
    <bpmn2:property id="failedHeaders" itemSubjectRef="_failedHeadersItem" name="failedHeaders"/>
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:sequenceFlow id="_flow_retry_loop" name="Yes" sourceRef="_CHECK_LIMIT" targetRef="_TIMER_MERGE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Yes]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3oFU-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return retryCount < maxRetryCount;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_check_limit" sourceRef="_INCREMENT_RETRY" targetRef="_CHECK_LIMIT"/>
    <bpmn2:sequenceFlow id="_flow2" sourceRef="_PARSE_SCRIPT" targetRef="_TIMER_MERGE"/>
    <bpmn2:sequenceFlow id="_flow1" sourceRef="_START_NODE" targetRef="_PARSE_SCRIPT"/>
    <bpmn2:sequenceFlow id="_flow_to_retry" sourceRef="_RETRY_MERGE" targetRef="_RETRY_REST"/>
    <bpmn2:sequenceFlow id="_flow_admin_retry" name="Force Retry" sourceRef="_ADMIN_DECISION_GATE" targetRef="_RETRY_MERGE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Force Retry]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3oVU-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return "RETRY".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_to_increment" sourceRef="_INCREMENT_MERGE" targetRef="_INCREMENT_RETRY"/>
    <bpmn2:sequenceFlow id="_flow_admin_terminate" name="Terminate Case" sourceRef="_ADMIN_DECISION_GATE" targetRef="_END_TERMINATE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Terminate Case]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3olU-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return "TERMINATE".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow3" sourceRef="_TIMER_NODE" targetRef="_RETRY_MERGE"/>
    <bpmn2:sequenceFlow id="_flow_to_timer" sourceRef="_TIMER_MERGE" targetRef="_TIMER_NODE"/>
    <bpmn2:sequenceFlow id="_flow_retry_error" sourceRef="_RETRY_REST_ERROR" targetRef="_INCREMENT_MERGE"/>
    <bpmn2:sequenceFlow id="_flow_fail_increment" name="No" sourceRef="_CHECK_SUCCESS" targetRef="_INCREMENT_MERGE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[No]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3o1U-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return resPayload == null || resPayload.isEmpty();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow4" sourceRef="_RETRY_REST" targetRef="_CHECK_SUCCESS"/>
    <bpmn2:sequenceFlow id="_flow_admin_action" sourceRef="_ADMIN_REVIEW" targetRef="_ADMIN_DECISION_GATE"/>
    <bpmn2:sequenceFlow id="_flow_limit_exceeded" name="No" sourceRef="_CHECK_LIMIT" targetRef="_ADMIN_REVIEW">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[No]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3pFU-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return retryCount >= maxRetryCount;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_admin_skip" name="Skip Node" sourceRef="_ADMIN_DECISION_GATE" targetRef="_END_MERGE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Skip Node]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3pVU-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return "SKIP".equals(adminDecision);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_success_end" name="Yes" sourceRef="_CHECK_SUCCESS" targetRef="_END_MERGE">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Yes]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_h1O3plU-EfGKZOvILHBitw" language="http://www.java.com/java"><![CDATA[return resPayload != null && !resPayload.isEmpty();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_flow_to_end_resume" sourceRef="_END_MERGE" targetRef="_END_NODE"/>
    <bpmn2:startEvent id="_START_NODE" name="Start Error Handler">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start Error Handler]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_flow1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:exclusiveGateway id="_TIMER_MERGE" name="Timer Merge" gatewayDirection="Converging">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Timer Merge]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow2</bpmn2:incoming>
      <bpmn2:incoming>_flow_retry_loop</bpmn2:incoming>
      <bpmn2:outgoing>_flow_to_timer</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="_INCREMENT_RETRY" name="Increment retryCount" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Increment retryCount]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow_to_increment</bpmn2:incoming>
      <bpmn2:outgoing>_flow_check_limit</bpmn2:outgoing>
      <bpmn2:script><![CDATA[int count = (int) kcontext.getVariable("retryCount");
kcontext.setVariable("retryCount", count + 1);

System.out.println("[BPM][RETRY] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=IncrementRetry | caseId=" + kcontext.getVariable("caseId") + " | attempt=" + (count + 1) + " | maxRetries=" + kcontext.getVariable("maxRetryCount") + " | failedEndpoint=" + kcontext.getVariable("failedEndpoint"));
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_CHECK_LIMIT" name="retryCount &lt; maxRetryCount?" gatewayDirection="Diverging">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[retryCount < maxRetryCount?]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow_check_limit</bpmn2:incoming>
      <bpmn2:outgoing>_flow_limit_exceeded</bpmn2:outgoing>
      <bpmn2:outgoing>_flow_retry_loop</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="_PARSE_SCRIPT" name="Script_ParseContext" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Script_ParseContext]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow1</bpmn2:incoming>
      <bpmn2:outgoing>_flow2</bpmn2:outgoing>
      <bpmn2:script><![CDATA[// 1. Initialize Base URL
String url = System.getProperty("INTEGRATION_LAYER_URL");
if (url == null || url.isEmpty()) { url = System.getenv("INTEGRATION_LAYER_URL"); }
if (url == null || url.isEmpty()) {
    try {
        url = (String) kcontext.getKieRuntime().getEnvironment().get("INTEGRATION_LAYER_URL");
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}
if (url == null || url.isEmpty()) { url = "http://localhost:3000"; }
kcontext.setVariable("baseUrl", url);

System.out.println("[BPM][BOOTSTRAP] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | caseId=" + kcontext.getVariable("caseId") + " | baseUrl=" + url);

// 2. Initialize default retry states if empty
if (kcontext.getVariable("retryCount") == null) { kcontext.setVariable("retryCount", 0); }
if (kcontext.getVariable("maxRetryCount") == null) { kcontext.setVariable("maxRetryCount", 3); }

// 3. Unpack the JSON context sent from the main process
String ctx = (String) kcontext.getVariable("failedContext");

System.out.println("[BPM][ENTRY] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | failedContext=" + (ctx != null ? ctx.substring(0, Math.min(ctx.length(), 200)) : "null"));
if (ctx != null && !ctx.isEmpty()) {
    try {
        com.fasterxml.jackson.databind.JsonNode node = new com.fasterxml.jackson.databind.ObjectMapper().readTree(ctx);
        String endpoint = node.get("url").asText();
        if (!endpoint.startsWith("http")) {
            endpoint = url + endpoint;
        }
        kcontext.setVariable("failedEndpoint", endpoint);
        kcontext.setVariable("failedPayload", node.get("payload").toString());
        
        String method = "POST";
        if (node.has("method")) {
            method = node.get("method").asText();
        }
        kcontext.setVariable("failedMethod", method);

        String headers = "";
        if (node.has("headers")) {
            headers = node.get("headers").asText();
        }
        kcontext.setVariable("failedHeaders", headers);

        System.out.println("[BPM][EXIT][OK] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | failedEndpoint=" + endpoint + " | failedMethod=" + method + " | failedHeaders=" + headers);
    } catch(Exception e) {
        System.out.println("[BPM][EXIT][ERROR] process=pru-api-error-handler | piid=" + kcontext.getProcessInstance().getId() + " | node=ParseContext | caseId=" + kcontext.getVariable("caseId") + " | error=" + e.getMessage());
    }
}
// Default method if not unpacked
if (kcontext.getVariable("failedMethod") == null) { kcontext.setVariable("failedMethod", "POST"); }
if (kcontext.getVariable("failedHeaders") == null) { kcontext.setVariable("failedHeaders", ""); }]]></bpmn2:script>
    </bpmn2:scriptTask>
