<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/bpmn20" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_def" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_TaskNameItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_AcceptCharsetItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_AcceptHeaderItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_AuthTypeItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_AuthUrlItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ConnectTimeoutItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ContentItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ContentDataItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ContentTypeItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ContentTypeCharsetItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_HandleResponseErrorsItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_HeadersItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_MethodItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_PasswordItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ReadTimeoutItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ResultClassItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_UrlItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_UsernameItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_ResultItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_caseIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_maxRetryCountItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_failedContextItem" structureRef="String"/>
  
  <bpmn2:error id="REST_API_FAILURE" errorCode="org.jbpm.bpmn2.handler.WorkItemHandlerRuntimeException"/>

  <bpmn2:process id="prudential-claims-submission.pru-rest-executor" drools:packageName="org.jbpm" drools:version="1.0" drools:adHoc="false" name="pru-rest-executor" isExecutable="true" processType="Public">
    <bpmn2:property id="TaskName" itemSubjectRef="_TaskNameItem" name="TaskName"/>
    <bpmn2:property id="AcceptCharset" itemSubjectRef="_AcceptCharsetItem" name="AcceptCharset"/>
    <bpmn2:property id="AcceptHeader" itemSubjectRef="_AcceptHeaderItem" name="AcceptHeader"/>
    <bpmn2:property id="AuthType" itemSubjectRef="_AuthTypeItem" name="AuthType"/>
    <bpmn2:property id="AuthUrl" itemSubjectRef="_AuthUrlItem" name="AuthUrl"/>
    <bpmn2:property id="ConnectTimeout" itemSubjectRef="_ConnectTimeoutItem" name="ConnectTimeout"/>
    <bpmn2:property id="Content" itemSubjectRef="_ContentItem" name="Content"/>
    <bpmn2:property id="ContentData" itemSubjectRef="_ContentDataItem" name="ContentData"/>
    <bpmn2:property id="ContentType" itemSubjectRef="_ContentTypeItem" name="ContentType"/>
    <bpmn2:property id="ContentTypeCharset" itemSubjectRef="_ContentTypeCharsetItem" name="ContentTypeCharset"/>
    <bpmn2:property id="HandleResponseErrors" itemSubjectRef="_HandleResponseErrorsItem" name="HandleResponseErrors"/>
    <bpmn2:property id="Headers" itemSubjectRef="_HeadersItem" name="Headers"/>
    <bpmn2:property id="Method" itemSubjectRef="_MethodItem" name="Method"/>
    <bpmn2:property id="Password" itemSubjectRef="_PasswordItem" name="Password"/>
    <bpmn2:property id="ReadTimeout" itemSubjectRef="_ReadTimeoutItem" name="ReadTimeout"/>
    <bpmn2:property id="ResultClass" itemSubjectRef="_ResultClassItem" name="ResultClass"/>
    <bpmn2:property id="Url" itemSubjectRef="_UrlItem" name="Url"/>
    <bpmn2:property id="Username" itemSubjectRef="_UsernameItem" name="Username"/>
    <bpmn2:property id="Result" itemSubjectRef="_ResultItem" name="Result"/>
    <bpmn2:property id="caseId" itemSubjectRef="_caseIdItem" name="caseId"/>
    <bpmn2:property id="maxRetryCount" itemSubjectRef="_maxRetryCountItem" name="maxRetryCount"/>
    <bpmn2:property id="failedContext" itemSubjectRef="_failedContextItem" name="failedContext"/>

    <bpmn2:startEvent id="_START" name="Start">
      <bpmn2:outgoing>_F1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="_F1" sourceRef="_START" targetRef="_REST_TASK"/>

    <bpmn2:task id="_REST_TASK" drools:taskName="Rest" name="REST Execution">
      <bpmn2:incoming>_F1</bpmn2:incoming>
      <bpmn2:outgoing>_F2</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_REST_io">
        <bpmn2:dataInput id="_R_Url" name="Url" structureRef="String"/>
        <bpmn2:dataInput id="_R_Method" name="Method" structureRef="String"/>
        <bpmn2:dataInput id="_R_Headers" name="Headers" structureRef="String"/>
        <bpmn2:dataInput id="_R_ContentData" name="ContentData" structureRef="String"/>
        <bpmn2:dataInput id="_R_ContentType" name="ContentType" structureRef="String"/>
        <bpmn2:dataInput id="_R_ResultClass" name="ResultClass" structureRef="String"/>
        <bpmn2:dataInput id="_R_ConnectTimeout" name="ConnectTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_R_ReadTimeout" name="ReadTimeout" structureRef="String"/>
        <bpmn2:dataInput id="_R_HandleResponseErrors" name="HandleResponseErrors" structureRef="String"/>
        <bpmn2:dataOutput id="_R_Result" name="Result" structureRef="String"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_R_Url</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_Method</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_Headers</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_ContentData</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_ContentType</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_ResultClass</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_ConnectTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_ReadTimeout</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_R_HandleResponseErrors</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_R_Result</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_R_assoc_Url">
        <bpmn2:sourceRef>Url</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_Url</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_Method">
        <bpmn2:sourceRef>Method</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_Method</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_Headers">
        <bpmn2:sourceRef>Headers</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_Headers</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_ContentData">
        <bpmn2:sourceRef>ContentData</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_ContentData</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_ContentType">
        <bpmn2:sourceRef>ContentType</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_ContentType</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_ResultClass">
        <bpmn2:sourceRef>ResultClass</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_ResultClass</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_ConnectTimeout">
        <bpmn2:sourceRef>ConnectTimeout</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_ConnectTimeout</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_ReadTimeout">
        <bpmn2:sourceRef>ReadTimeout</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_ReadTimeout</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_R_assoc_HandleResponseErrors">
        <bpmn2:sourceRef>HandleResponseErrors</bpmn2:sourceRef>
        <bpmn2:targetRef>_R_HandleResponseErrors</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_R_assoc_Result">
        <bpmn2:sourceRef>_R_Result</bpmn2:sourceRef>
        <bpmn2:targetRef>Result</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    
    <bpmn2:sequenceFlow id="_F2" sourceRef="_REST_TASK" targetRef="_END_SUCCESS"/>
    
    <bpmn2:endEvent id="_END_SUCCESS" name="End Success">
      <bpmn2:incoming>_F2</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- Error Handling Boundary -->
    <bpmn2:boundaryEvent id="_B_ERROR" name="Catch REST Failure" attachedToRef="_REST_TASK" cancelActivity="true">
      <bpmn2:outgoing>_F3</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="_B_ERR_DEF" errorRef="REST_API_FAILURE"/>
    </bpmn2:boundaryEvent>

    <bpmn2:sequenceFlow id="_F3" sourceRef="_B_ERROR" targetRef="_BUILD_CTX"/>

    <bpmn2:scriptTask id="_BUILD_CTX" name="Build Context" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>_F3</bpmn2:incoming>
      <bpmn2:outgoing>_F4</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
String urlVal = (String) kcontext.getVariable("Url");
String payloadVal = (String) kcontext.getVariable("ContentData");
String methodVal = (String) kcontext.getVariable("Method");
String headersVal = (String) kcontext.getVariable("Headers");

if (urlVal == null) urlVal = "";
if (payloadVal == null || payloadVal.isEmpty()) payloadVal = "{}";
if (methodVal == null) methodVal = "POST";
String escapedHeaders = headersVal != null ? headersVal.replace("\"", "\\\"") : "";

String ctx = "{\"url\":\"" + urlVal + "\", \"payload\":" + payloadVal + ", \"method\":\"" + methodVal + "\", \"headers\":\"" + escapedHeaders + "\"}";
kcontext.setVariable("failedContext", ctx);
      ]]></bpmn2:script>
    </bpmn2:scriptTask>

    <bpmn2:sequenceFlow id="_F4" sourceRef="_BUILD_CTX" targetRef="_CALL_ERR"/>

    <bpmn2:callActivity id="_CALL_ERR" name="Call API Error Handler" calledElement="prudential-claims-submission.pru-api-error-handler" drools:independent="false" drools:waitForCompletion="true">
      <bpmn2:incoming>_F4</bpmn2:incoming>
      <bpmn2:outgoing>_F5</bpmn2:outgoing>
      <bpmn2:ioSpecification id="_CALL_ERR_io">
        <bpmn2:dataInput id="_C_failedContext" name="failedContext" structureRef="String"/>
        <bpmn2:dataInput id="_C_caseId" name="caseId" structureRef="String"/>
        <bpmn2:dataInput id="_C_maxRetryCount" name="maxRetryCount" structureRef="Integer"/>
        <bpmn2:dataOutput id="_C_out_failedContext" name="failedContext" structureRef="String"/>
        <bpmn2:dataOutput id="_C_out_resPayload" name="resPayload" structureRef="String"/>
        <bpmn2:inputSet id="_CALL_ERR_input_set">
          <bpmn2:dataInputRefs>_C_failedContext</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_C_caseId</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_C_maxRetryCount</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet id="_CALL_ERR_output_set">
          <bpmn2:dataOutputRefs>_C_out_failedContext</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_C_out_resPayload</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation id="_C_assoc_failedContext">
        <bpmn2:sourceRef>failedContext</bpmn2:sourceRef>
        <bpmn2:targetRef>_C_failedContext</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_C_assoc_caseId">
        <bpmn2:sourceRef>caseId</bpmn2:sourceRef>
        <bpmn2:targetRef>_C_caseId</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation id="_C_assoc_maxRetryCount">
        <bpmn2:sourceRef>maxRetryCount</bpmn2:sourceRef>
        <bpmn2:targetRef>_C_maxRetryCount</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="_C_out_assoc">
        <bpmn2:sourceRef>_C_out_failedContext</bpmn2:sourceRef>
        <bpmn2:targetRef>failedContext</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation id="_C_out_assoc_Result">
        <bpmn2:sourceRef>_C_out_resPayload</bpmn2:sourceRef>
        <bpmn2:targetRef>Result</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:callActivity>

    <bpmn2:sequenceFlow id="_F5" sourceRef="_CALL_ERR" targetRef="_END_ERROR"/>
    
    <bpmn2:endEvent id="_END_ERROR" name="End Handled">
      <bpmn2:incoming>_F5</bpmn2:incoming>
    </bpmn2:endEvent>

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="_DI">
    <bpmndi:BPMNPlane id="_PLANE" bpmnElement="prudential-claims-submission.pru-rest-executor">
      <bpmndi:BPMNShape id="_S_START" bpmnElement="_START">
        <dc:Bounds height="56.0" width="56.0" x="100.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_REST_TASK" bpmnElement="_REST_TASK">
        <dc:Bounds height="80.0" width="120.0" x="250.0" y="88.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_END_SUCCESS" bpmnElement="_END_SUCCESS">
        <dc:Bounds height="56.0" width="56.0" x="450.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_END_ERROR" bpmnElement="_END_ERROR">
        <dc:Bounds height="56.0" width="56.0" x="590.0" y="252.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_B_ERROR" bpmnElement="_B_ERROR">
        <dc:Bounds height="36.0" width="36.0" x="310.0" y="150.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_BUILD_CTX" bpmnElement="_BUILD_CTX">
        <dc:Bounds height="80.0" width="120.0" x="268.0" y="240.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_S_CALL_ERR" bpmnElement="_CALL_ERR">
        <dc:Bounds height="80.0" width="120.0" x="430.0" y="240.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="_E_F1" bpmnElement="_F1">
        <di:waypoint x="156.0" y="128.0"/>
        <di:waypoint x="250.0" y="128.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_E_F2" bpmnElement="_F2">
        <di:waypoint x="370.0" y="128.0"/>
        <di:waypoint x="450.0" y="128.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_E_F3" bpmnElement="_F3">
        <di:waypoint x="328.0" y="186.0"/>
        <di:waypoint x="328.0" y="240.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_E_F4" bpmnElement="_F4">
        <di:waypoint x="388.0" y="280.0"/>
        <di:waypoint x="430.0" y="280.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_E_F5" bpmnElement="_F5">
        <di:waypoint x="550.0" y="280.0"/>
        <di:waypoint x="590.0" y="280.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
